+def _lazy_is_generator(f: Callable) -> Callable[[], bool]:
+    """
+    Return a function that tells whether *f* is a generator function.
+
+    The check is deferred until the returned function is called and the answer
+    is cached in `_IS_GENERATOR_RESULTS`. Unhashable callables are not cached.
+    """
+
+    def is_generator() -> bool:
+        import inspect
+
+        try:
+            return _IS_GENERATOR_RESULTS[f]
+        except KeyError:
+            pass
+        except TypeError:
+            return inspect.isgeneratorfunction(f)
+
+        result = _IS_GENERATOR_RESULTS[f] = inspect.isgeneratorfunction(f)
+        return result
+
+    return is_generator
