 # If they have such a reference, it breaks cloudpickle.
 repr_context = threading.local()
 
+# Cache of whether a callable is a generator function, keyed by the callable.
+_IS_GENERATOR_RESULTS = {}
+
+
+def _lazy_is_generator(f):
+    """
+    Return a callable that tells whether *f* is a generator function.
+
+    The answer is computed on first call and cached in
+    `_IS_GENERATOR_RESULTS`. Unhashable callables are not cached.
+
+    The check is lazy because it runs at class creation for every attrs class
+    with hooks.
+    """
+
+    def inner():
+        import inspect
+
+        try:
+            return _IS_GENERATOR_RESULTS[f]
+        except KeyError:
+            result = inspect.isgeneratorfunction(f)
+            _IS_GENERATOR_RESULTS[f] = result
+            return result
+        except TypeError:  # unhashable
+            return inspect.isgeneratorfunction(f)
+
+    return inner
+
 
 def get_generic_base(cl):
     """If this is a generic class (A[str]), return the generic base for it."""
