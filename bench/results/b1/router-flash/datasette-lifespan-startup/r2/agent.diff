+    async def _startup_sequence(self):
+        """The single idempotent entry point used by AsgiLifespan,
+        AsgiRunOnFirstRequest and ``datasette serve``.
+
+        It precomputes table counts for immutable databases (once) and then
+        runs ``invoke_startup()``, guarded by a lock so that concurrent
+        callers only ever perform the work once.
+        """
+        if self._startup_invoked and self._setup_db_done:
+            return
+        async with self._startup_lock:
+            # Re-check under the lock - another caller may have finished
+            if self._startup_invoked and self._setup_db_done:
+                return
+            if not self._setup_db_done:
+                # First time server starts up, calculate table counts for
+                # immutable databases
+                for database in self.databases.values():
+                    if not database.is_mutable:
+                        await database.table_counts(limit=60 * 60 * 1000)
+                self._setup_db_done = True
+            # invoke_startup() is itself a no-op once _startup_invoked is set
+            await self.invoke_startup()
+
