it": 0, "concurrency_limit": 0, "budget": 0}, "by_type": {"implementer": 1}}, "safety_stops": 0, "is_error": false, "num_turns": 2, "subtype": "success", "api_error_status": null, "result": "`create view` and `drop view` now work through `/<db>/-/execute-write` for actors who hold `create-view` or `drop-view`. Any other actor gets a 403 naming the missing permission.\n\nI reviewed the implementer's diff against the spec and it matches. I re-ran `.venv/bin/python -m pytest -q tests/test_queries.py` myself, and all 90 tests passed. The implementer also ran `tests/test_utils_sql_analysis.py`, `tests/test_permissions.py`, `tests/test_docs.py` and `tests/test_api_write.py`, which passed too.\n\nThe changes are in `datasette/default_actions.py`, `datasette/write_sql.py`, `datasette/utils/sql_analysis.py` and `docs/authentication.rst`. Dropping a view no longer produces a `delete-row` requirement. Nothing is committed.", "ttft_ms": 2224, "type": "result", "duration_ms": 11569, "uuid": "4432ae6b-4710-4a58-84bc-fd8cf0480874", "ttft_stream_ms": 1929, "time_to_request_ms": 15, "first_content_frame_ms": 1929, "queued_turn_count": 0, "result_index": 1}
