+    async def _startup_sequence(self):
+        """Run full Datasette startup exactly once.
+
+        This is the single idempotent entry point used by AsgiLifespan,
+        AsgiRunOnFirstRequest and `datasette serve`. It precomputes table
+        counts for immutable databases, then runs invoke_startup(). Callers
+        may race for it; the lock ensures the work happens once.
+        """
+        if self._startup_invoked and self._setup_db_done:
+            return
+        async with self._startup_lock:
+            if self._startup_invoked and self._setup_db_done:
+                return
+            if not self._setup_db_done:
+                # First time server starts up, calculate table counts for immutable databases
+                for database in self.databases.values():
+                    if not database.is_mutable:
+                        await database.table_counts(limit=60 * 60 * 1000)
+                self._setup_db_done = True
+            await self.invoke_startup()
+
