+    def _output_segment_hashes(
+        self, tip_hash: str | None, parent_hash: str | None
+    ) -> list[str]:
+        """Hashes of the turn's own output messages - walked from the tip
+        back to the parent, oldest first."""
+        hashes: list[str] = []
+        hash_ = tip_hash
+        while hash_ and hash_ != parent_hash:
+            message_row = next(
+                iter(
+                    self.store.db.query(
+                        "select parent_hash from messages where hash = ?",
+                        [hash_],
+                    )
+                ),
+                None,
+            )
+            if message_row is None:
+                break
+            hashes.append(hash_)
+            hash_ = message_row["parent_hash"]
+        hashes.reverse()
+        return hashes
+
 
