+def _lazy_is_generator(f: Callable) -> Callable[[], bool]:
+    """
+    Return a callable that answers whether *f* is a generator function, with
+    caching.
+
+    The answer is stored in :data:`_IS_GENERATOR_RESULTS[f]` the first time.
+    If *f* is not hashable, the answer is returned uncached.
+    """
+
+    def check() -> bool:
+        import inspect
+
+        try:
+            return _IS_GENERATOR_RESULTS[f]
+        except (KeyError, TypeError):
+            pass
+
+        result = inspect.isgeneratorfunction(f)
+
+        try:
+            _IS_GENERATOR_RESULTS[f] = result
+        except TypeError:
+            pass
+
+        return result
+
+    return check
+
