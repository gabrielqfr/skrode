+from collections.abc import Callable, Mapping, Sequence  # noqa: F401
 from typing import _GenericAlias
 
 
+# Cache for the lazy "is generator function" check in _lazy_is_generator.
+_IS_GENERATOR_RESULTS = {}
+
+
+def _lazy_is_generator(f: Callable) -> Callable[[], bool]:
+    """
+    Return a closure that lazily determines and caches whether *f* is a
+    generator function.
+
+    The check is done lazily because it is invoked during class creation for
+    every attribute on *attrs* classes that carry hooks, so importing
+    `inspect` is deferred to the first use and the result is memoised in
+    ``_IS_GENERATOR_RESULTS`` the first time it is needed.
+
+    If *f* is not hashable, the result is simply returned without being
+    cached.
+    """
+
+    def _is_generator() -> bool:
+        import inspect
+
+        try:
+            return _IS_GENERATOR_RESULTS[f]
+        except (KeyError, TypeError):
+            # Not yet cached (or f is unhashable, in which case it never will
+            # be).  Compute it and cache it if possible.
+            result = inspect.isgeneratorfunction(f)
+            try:
+                _IS_GENERATOR_RESULTS[f] = result
+            except TypeError:
+                # f is not hashable; don't cache the result.
+                pass
+            return result
+
+    return _is_generator
+
