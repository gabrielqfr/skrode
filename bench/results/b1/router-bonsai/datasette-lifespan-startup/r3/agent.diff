+    async def _startup_sequence(self):
+        """
+        The single idempotent entry point used by ``AsgiLifespan``,
+        ``AsgiRunOnFirstRequest`` and ``datasette serve`` to run Datasette
+        startup (the immutable-database table-count precompute followed by
+        ``invoke_startup()``).
+
+        It is guarded by ``self._startup_lock`` and checks both
+        ``self._startup_invoked`` and ``self._setup_db_done`` so that it is
+        safe no matter which subset of work has already been done. In
+        particular, a caller (such as ``serve``) may run a bare
+        ``invoke_startup()`` first, which only sets ``_startup_invoked``;
+        the immutable-database precompute must still run once afterwards,
+        which is why both flags are checked rather than just one.
+        """
+        if self._startup_invoked and self._setup_db_done:
+            return
+        async with self._startup_lock:
+            if self._startup_invoked and self._setup_db_done:
+                return
+            if not self._setup_db_done:
+                for database in self.databases.values():
+                    if not database.is_mutable:
+                        await database.table_counts(limit=60 * 60 * 1000)
+                self._setup_db_done = True
+            await self.invoke_startup()
+
