+class _Level(logging.Filter):
+    """Passes records at ``floor`` and up, and ``sensei_top.llm``'s INFO lines
+    below it (the cost line of each generate call, which users are promised)."""
+
+    def __init__(self, floor: int) -> None:
+        super().__init__()
+        self.floor = floor
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        if record.levelno >= self.floor:
+            return True
+        llm = record.name == "sensei_top.llm" or record.name.startswith("sensei_top.llm.")
+        return record.levelno >= logging.INFO and llm
+
