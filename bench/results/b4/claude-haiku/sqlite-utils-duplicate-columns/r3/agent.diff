+def dedupe_keys(keys: Iterable[str]) -> List[str]:
+    """
+    Rename duplicate keys so every name is unique, for use when converting
+    rows to dictionaries. Later occurrences of a repeated name get ``_2``,
+    ``_3`` and so on appended, skipping any suffix that would collide with
+    another column.
+
+    Example usage::
+
+        from sqlite_utils.utils import dedupe_keys
+
+        dedupe_keys(["id", "name", "id"])
+        # Returns ["id", "name", "id_2"]
+
+    :param keys: Column names, possibly containing duplicates
+    """
+    keys = list(keys)
+    if len(set(keys)) == len(keys):
+        return keys
+    original = set(keys)
+    produced: Set[str] = set()
+    result: List[str] = []
+    for key in keys:
+        name = key
+        if name in produced:
+            n = 2
+            while f"{key}_{n}" in original or f"{key}_{n}" in produced:
+                n += 1
+            name = f"{key}_{n}"
+        produced.add(name)
+        result.append(name)
+    return result
+
+
