+/** The options split for the chips: `main` at or above `MAIN_SHARE`, and
+ *  `other` the rest, the no-share ones among them. Order is kept. */
+export function splitOptions(options: ExpectedOption[]): { main: ExpectedOption[]; other: ExpectedOption[] } {
+  const main = options.filter((option) => option.share != null && option.share >= MAIN_SHARE)
+  const other = options.filter((option) => !main.includes(option))
+  return { main, other }
