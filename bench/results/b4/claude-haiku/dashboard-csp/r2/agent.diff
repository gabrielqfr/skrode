@@ -51,6 +51,20 @@ from starlette.responses import Response
 from starlette.staticfiles import StaticFiles
 from starlette.types import Scope
 
+# Every dashboard response carries this. Each directive is here for a reason:
+# - default-src 'self': nothing loads from another origin.
+# - style-src 'unsafe-inline': React's style={...} props write inline styles.
+# - font-src data: the CSS inlines its woff2 fonts as data: URLs.
+# - img-src 'self': card images come from the API's own routes.
+# - frame-ancestors 'none': no page may frame the dashboard.
+# - base-uri 'self' and object-src 'none': close two injection paths.
+# No script is inline, so script-src falls back to 'self' and needs no
+# 'unsafe-inline'.
+CONTENT_SECURITY_POLICY = (
+    "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; "
+    "img-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
+)
+
 _SEPARATORS = re.compile(r"[\\/]+")
 
 
