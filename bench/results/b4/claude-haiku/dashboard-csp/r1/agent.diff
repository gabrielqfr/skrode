+# Each directive, and why the dashboard needs it:
+# - style-src 'unsafe-inline': React's style={...} props write inline styles.
+# - no script-src: no script in the build is inline, so 'self' is the default.
+# - font-src data:: the CSS inlines its woff2 fonts as data: URLs.
+# - img-src 'self': card images come from the API's own routes.
+# - frame-ancestors, base-uri, object-src: nothing frames the dashboard, sets a
+#   base URL, or embeds plugins.
+CONTENT_SECURITY_POLICY = (
+    "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; "
+    "img-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
+)
+
 _SEPARATORS = re.compile(r"[\\/]+")
 
 
