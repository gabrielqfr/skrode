@@ -51,6 +51,19 @@ from starlette.responses import Response
 from starlette.staticfiles import StaticFiles
 from starlette.types import Scope
 
+# Each directive is here for a reason the dashboard has, so none is loosened
+# beyond it. ``default-src 'self'`` covers scripts, which are all external
+# files (no script is inline). ``style-src`` needs ``'unsafe-inline'``
+# because React's ``style={...}`` props set inline styles. ``font-src`` allows
+# ``data:`` because the CSS inlines its woff2 fonts. ``img-src`` is ``'self'``
+# because card images come from the API's own routes. ``frame-ancestors``,
+# ``base-uri`` and ``object-src`` lock what nothing here needs: no framing, no
+# ``<base>`` redirection, no plugins.
+CONTENT_SECURITY_POLICY = (
+    "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; "
+    "img-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
+)
+
 _SEPARATORS = re.compile(r"[\\/]+")
 
 
