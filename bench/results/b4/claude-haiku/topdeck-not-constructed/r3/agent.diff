+# TopDeck organisers label Commander nights, drafts, sealed and prerelease
+# events "Standard"; these match on the tournament name so such an event is
+# never stored as Standard constructed. Leading boundary only, so "Pre Release",
+# "Prerelease" and the misspelt "PreRealese" all match.
+_NOT_CONSTRUCTED_RE = re.compile(
+    r"(?<![a-z])(commander|edh|draft|sealed|cube|jumpstart|pre.?r?e?a?l)",
+    re.IGNORECASE,
+)
+
 # One request line per tournament line in a decklist export: "4 Lightning
 # Bolt" or "4x Lightning Bolt". Fallback path only, for a standings row whose
 # deckObj carries no recognisable Mainboard/Sideboard structure — see
@@ -275,6 +284,32 @@ def _blob_sha(payload: dict[str, Any]) -> str:
     return hashlib.sha256(canonical).hexdigest()
 
 
+def _purge_not_constructed(conn) -> None:
+    """Delete every stored TopDeck event whose name says it isn't Standard
+    constructed, with the rows that point at it. Events stored before the
+    name filter existed are removed on the next refresh."""
+    rows = conn.execute(
+        "SELECT event_id, name FROM meta_event WHERE event_id LIKE 'Tournaments/Topdeck/%'"
+    ).fetchall()
+    doomed = [r["event_id"] for r in rows if _NOT_CONSTRUCTED_RE.search(r["name"] or "")]
+    if not doomed:
+        return
+    conn.execute("BEGIN")
+    try:
+        for event_id in doomed:
+            conn.execute(
+                "UPDATE meta_event SET duplicate_of = NULL WHERE duplicate_of = ?", (event_id,)
+            )
+            for table in ("meta_deck_archetype", "meta_round_match", "meta_deck"):
+                conn.execute(f"DELETE FROM {table} WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_event WHERE event_id = ?", (event_id,))
+        conn.execute("COMMIT")
+    except Exception:
+        conn.execute("ROLLBACK")
+        raise
+    log.warning("purged %d topdeck event(s) that are not Standard constructed", len(doomed))
+
