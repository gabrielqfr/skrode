+# TopDeck organisers label Commander nights, drafts, sealed and prerelease
+# events "Standard", so the format filter alone lets them in as Standard
+# constructed. Matched on the tournament name, leading boundary only, so
+# "Pre Release", "Prerelease" and misspellings like "PreRealese" all match.
+_NOT_CONSTRUCTED_RE = re.compile(
+    r"(?<![a-z])(commander|edh|draft|sealed|cube|jumpstart|pre.?r?e?a?l)",
+    re.IGNORECASE,
+)
+
