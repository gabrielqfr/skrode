+def _purge_not_constructed(conn) -> None:
+    """Delete stored TopDeck events whose name says they are not Standard
+    constructed — organisers label Commander, draft and sealed nights
+    "Standard"."""
+    rows = conn.execute(
+        "SELECT event_id, name FROM meta_event WHERE event_id LIKE 'Tournaments/Topdeck/%'"
+    ).fetchall()
+    doomed = [r[0] for r in rows if _NOT_CONSTRUCTED_RE.search(str(r[1] or ""))]
+    if not doomed:
+        return
+    conn.execute("BEGIN")
+    try:
+        for event_id in doomed:
+            conn.execute(
+                "UPDATE meta_event SET duplicate_of = NULL WHERE duplicate_of = ?", (event_id,)
+            )
+            for table in ("meta_deck_archetype", "meta_round_match", "meta_deck", "meta_event"):
+                conn.execute(f"DELETE FROM {table} WHERE event_id = ?", (event_id,))
+        conn.execute("COMMIT")
+    except Exception:
+        conn.execute("ROLLBACK")
+        raise
+    log.warning("purged %d stored topdeck event(s) that are not Standard constructed", len(doomed))
+
