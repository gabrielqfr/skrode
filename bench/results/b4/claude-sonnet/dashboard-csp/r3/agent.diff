@@ -51,6 +51,20 @@ from starlette.responses import Response
 from starlette.staticfiles import StaticFiles
 from starlette.types import Scope
 
+# Why each directive:
+# - default-src 'self': nothing loads from outside the app's own origin.
+# - style-src adds 'unsafe-inline' because React ``style={...}`` props set
+#   inline styles; no script is inline, so script-src stays 'self'.
+# - font-src adds data: because the CSS inlines its woff2 fonts as data: URLs.
+# - img-src 'self': card images come from the API's own routes.
+# - frame-ancestors 'none': no page may embed the dashboard.
+# - base-uri 'self': a injected <base> cannot redirect relative URLs.
+# - object-src 'none': no plugins.
+CONTENT_SECURITY_POLICY = (
+    "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; "
+    "img-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
+)
+
 _SEPARATORS = re.compile(r"[\\/]+")
 
 
