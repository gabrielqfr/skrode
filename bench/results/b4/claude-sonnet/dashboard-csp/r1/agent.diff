+# default-src 'self': everything not listed below comes from this origin.
+# No script-src of its own: no script is inline, so scripts fall back to
+# default-src. style-src adds 'unsafe-inline' because React ``style={...}``
+# props render as inline style attributes. font-src adds data: because the
+# CSS inlines its woff2 fonts. img-src is 'self' alone: card images come
+# from the API's own routes. frame-ancestors 'none' refuses being framed,
+# base-uri 'self' stops a injected <base> from redirecting relative URLs,
+# and object-src 'none' allows no plugins.
+CONTENT_SECURITY_POLICY = (
+    "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; "
+    "img-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
