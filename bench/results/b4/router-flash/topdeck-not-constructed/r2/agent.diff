+def _purge_not_constructed(conn) -> None:
+    """Delete already-stored TopDeck events whose name says they are not
+    Standard constructed — a Commander night, a draft, a sealed or a
+    prerelease — together with every row of theirs.
+
+    Refresh-time skipping only helps from now on; a label like "fractured pre
+    release" was stored as a Standard event by every earlier run, and nothing
+    else in this corpus ever revisits a stored event's name. So this runs on
+    every refresh, over exactly the rows this source wrote (the
+    ``Tournaments/Topdeck/`` event_id prefix), and takes each stale event's
+    whole footprint with it — ``meta_deck``, ``meta_round_match`` and
+    ``meta_deck_archetype`` are deleted rather than filtered, the same choice
+    ``metagame/dedup.py`` makes for a twin, so no reader that joins them needs
+    to learn about this. Any event whose ``duplicate_of`` pointed at the
+    purged one is released back to NULL first (a foreign key otherwise blocks
+    the delete) so it counts on its own again.
+
+    All the matching deletes happen in one transaction, rolled back and
+    re-raised on error, exactly like refresh_topdeck's own write. A refresh
+    with nothing stale writes nothing and logs nothing.
+    """
+    matched = [
+        row["event_id"]
+        for row in conn.execute(
+            "SELECT event_id, name FROM meta_event WHERE event_id LIKE 'Tournaments/Topdeck/%'"
+        )
+        if _NOT_CONSTRUCTED_RE.search(str(row["name"] or ""))
+    ]
+    if not matched:
+        return
+    conn.execute("BEGIN")
+    try:
+        for event_id in matched:
+            conn.execute(
+                "UPDATE meta_event SET duplicate_of = NULL WHERE duplicate_of = ?", (event_id,)
+            )
+            conn.execute("DELETE FROM meta_deck_archetype WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_round_match WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_deck WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_event WHERE event_id = ?", (event_id,))
+        conn.execute("COMMIT")
+    except Exception:
+        conn.execute("ROLLBACK")
+        raise
+    log.warning("purged %d non-constructed TopDeck event(s)", len(matched))
+
