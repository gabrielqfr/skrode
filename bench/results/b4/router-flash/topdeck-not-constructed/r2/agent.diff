+# TopDeck's format filter is the only structured label these tournaments
+# carry, and organisers run Commander nights, drafts, sealeds and
+# prereleases under it anyway. The tournament name is the only honest signal
+# that a "Standard" row is not Standard constructed, so it is matched here.
+# The lookbehind is deliberately the *only* boundary: it anchors a match to a
+# word start so an unrelated substring cannot trip it, while still catching
+# "Pre Release", "Prerelease" and the misspelt "PreRealese" alike (spacing and
+# the vowels around the "r" are optional because organisers spell it every
+# way). No trailing boundary — "Draft" and "Prerelease" are often run
+# together with something else ("Sunday Draft+Sealed", "PrereleaseWeekend").
+_NOT_CONSTRUCTED_RE = re.compile(
+    r"(?<![a-z])(commander|edh|draft|sealed|cube|jumpstart|pre.?r?e?a?l)",
+    re.IGNORECASE,
+)
+
