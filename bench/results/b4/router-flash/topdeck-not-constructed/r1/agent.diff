 # deckObj carries no recognisable Mainboard/Sideboard structure — see
@@ -275,6 +285,43 @@ def _blob_sha(payload: dict[str, Any]) -> str:
     return hashlib.sha256(canonical).hexdigest()
 
 
+def _purge_not_constructed(conn) -> None:
+    """Delete already-stored TopDeck events whose name marks them as not
+    Standard constructed (Commander nights, drafts, sealed, prereleases),
+    along with every row keyed on their ``event_id``. Idempotent: a second
+    call matches nothing and is a no-op, and a duplicate twin pointing at a
+    purged event is unlinked rather than left dangling."""
+    rows = conn.execute(
+        """
+        SELECT event_id, name FROM meta_event
+         WHERE event_id LIKE 'Tournaments/Topdeck/%'
+        """
+    ).fetchall()
+    doomed = [
+        row["event_id"]
+        for row in rows
+        if _NOT_CONSTRUCTED_RE.search(str(row["name"] or ""))
+    ]
+    if not doomed:
+        return
+    conn.execute("BEGIN")
+    try:
+        for event_id in doomed:
+            conn.execute(
+                "UPDATE meta_event SET duplicate_of = NULL WHERE duplicate_of = ?",
+                (event_id,),
+            )
+            conn.execute("DELETE FROM meta_deck_archetype WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_round_match WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_deck WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_event WHERE event_id = ?", (event_id,))
+        conn.execute("COMMIT")
+    except Exception:
+        conn.execute("ROLLBACK")
+        raise
+    log.warning("purged %d non-constructed TopDeck event(s)", len(doomed))
+
