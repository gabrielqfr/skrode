+# TopDeck organisers label Commander nights, drafts, sealed and prerelease
+# events "Standard", so the API's own format filter lets them through and they
+# would be stored as Standard constructed results. Matched against the
+# tournament name: a leading boundary only, so "Pre Release", "Prerelease" and
+# the misspelt "PreRealese" all match while a name that merely contains these
+# letters inside another word (e.g. "std") does not.
+_NOT_CONSTRUCTED_RE = re.compile(
+    r"(?<![a-z])(commander|edh|draft|sealed|cube|jumpstart|pre.?r?e?a?l)", re.IGNORECASE
+)
+
 # One request line per tournament line in a decklist export: "4 Lightning
