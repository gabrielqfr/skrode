 # deckObj carries no recognisable Mainboard/Sideboard structure — see
@@ -275,6 +283,40 @@ def _blob_sha(payload: dict[str, Any]) -> str:
     return hashlib.sha256(canonical).hexdigest()
 
 
+def _purge_not_constructed(conn) -> None:
+    """Delete every already-stored TopDeck event whose own name labels it as
+    something other than Standard constructed — an event stored before this
+    filter existed, or between two refreshes, would otherwise keep polluting
+    the metagame forever. One transaction for the whole purge, so a partial
+    delete can never leave a deck without its event or vice versa."""
+    offenders = [
+        row["event_id"]
+        for row in conn.execute(
+            "SELECT event_id, name FROM meta_event WHERE event_id LIKE 'Tournaments/Topdeck/%'"
+        )
+        if _NOT_CONSTRUCTED_RE.search(str(row["name"] or ""))
+    ]
+    if not offenders:
+        return
+    conn.execute("BEGIN")
+    try:
+        for event_id in offenders:
+            conn.execute(
+                "UPDATE meta_event SET duplicate_of = NULL WHERE duplicate_of = ?", (event_id,)
+            )
+            conn.execute("DELETE FROM meta_deck_archetype WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_round_match WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_deck WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_event WHERE event_id = ?", (event_id,))
+        conn.execute("COMMIT")
+    except Exception:
+        conn.execute("ROLLBACK")
+        raise
+    log.warning(
+        "topdeck: purged %d non-constructed event(s) stored as Standard", len(offenders)
+    )
+
