+# TopDeck organisers label Commander nights, drafts, sealed and prerelease
+# events "Standard", so the API's own ``format`` filter is not enough. Leading
+# boundary only: "Pre Release", "Prerelease" and the misspelt "PreRealese"
+# all still contain the word, while a name like "Standard" never matches.
+_NOT_CONSTRUCTED_RE = re.compile(
+    r"(?<![a-z])(commander|edh|draft|sealed|cube|jumpstart|pre.?r?e?a?l)", re.IGNORECASE
+)
+
