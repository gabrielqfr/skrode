@@ -51,6 +51,24 @@ from starlette.responses import Response
 from starlette.staticfiles import StaticFiles
 from starlette.types import Scope
 
+# The dashboard's own policy, sent alongside the frame-ancestors-only one
+# LoopbackGuard adds to every response. Each directive is here for a reason:
+# * ``default-src 'self'``: everything else comes from this origin.
+# * ``style-src 'self' 'unsafe-inline'``: React ``style={...}`` props reach the
+#   page as inline styles, which only ``'unsafe-inline'`` allows.
+# * ``font-src 'self' data:``: the built CSS inlines woff2 fonts as ``data:``.
+# * ``img-src 'self'``: card images come from the API's own routes.
+# * ``frame-ancestors 'none'``: nothing may frame the dashboard.
+# * ``base-uri 'self'``: no injected ``<base>`` may move relative URLs.
+# * ``object-src 'none'``: no plugin content is needed.
+# No ``script-src`` is spelled out because no script is inline, so
+# ``default-src 'self'`` covers scripts.
+CONTENT_SECURITY_POLICY = (
+    "default-src 'self'; style-src 'self' 'unsafe-inline'; "
+    "font-src 'self' data:; img-src 'self'; frame-ancestors 'none'; "
+    "base-uri 'self'; object-src 'none'"
+)
+
 _SEPARATORS = re.compile(r"[\\/]+")
 
 
