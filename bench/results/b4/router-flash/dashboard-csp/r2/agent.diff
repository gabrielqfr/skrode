@@ -51,6 +51,26 @@ from starlette.responses import Response
 from starlette.staticfiles import StaticFiles
 from starlette.types import Scope
 
+# The dashboard's own policy, one directive per need:
+#   default-src 'self'       everything else loads from this origin;
+#   style-src 'self' 'unsafe-inline'
+#                            React ``style={...}`` props become inline
+#                            ``style`` attributes, which need
+#                            ``'unsafe-inline'`` for styles (script is
+#                            not allowed inline at all: no script-src is
+#                            named and ``default-src`` has no
+#                            ``'unsafe-inline'``);
+#   font-src 'self' data:    the CSS inlines woff2 fonts as ``data:`` URIs;
+#   img-src 'self'           card images come from the API's own routes;
+#   frame-ancestors 'none'   the page may not be framed (LoopbackGuard
+#                            adds its own copy of this on every response);
+#   base-uri 'self'          a page cannot retarget relative URLs;
+#   object-src 'none'        no plugin content.
+CONTENT_SECURITY_POLICY = (
+    "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; "
+    "img-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
+)
+
 _SEPARATORS = re.compile(r"[\\/]+")
 
 
@@ -68,7 +88,17 @@ class DashboardFiles(StaticFiles):
         """The parent's answer whenever it finds a file. Its 404, raised or
         returned, becomes ``index.html`` for a GET or a HEAD of a page's path.
         Any other status stands, and so does a 404 under ``api`` or
-        ``assets``."""
+        ``assets``.
+
+        Whatever ``_answer`` returns carries the dashboard's own
+        Content-Security-Policy; ``LoopbackGuard`` adds a second,
+        frame-ancestors-only one on top of it.
+        """
+        response = await self._answer(path, scope)
+        response.headers["Content-Security-Policy"] = CONTENT_SECURITY_POLICY
+        return response
