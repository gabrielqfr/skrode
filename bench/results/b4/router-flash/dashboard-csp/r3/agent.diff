@@ -51,6 +51,26 @@ from starlette.responses import Response
 from starlette.staticfiles import StaticFiles
 from starlette.types import Scope
 
+# The dashboard's own CSP, one reason per directive:
+#
+# 1. ``default-src 'self'``: everything the page loads comes from this
+#    origin, and nothing else is allowed by default. No script is inline,
+#    so ``script-src`` needs no directive of its own: this one covers it.
+# 2. ``style-src 'self' 'unsafe-inline'``: the build's CSS arrives as a
+#    file, but React ``style={...}`` props write a ``style`` attribute,
+#    which needs ``'unsafe-inline'``.
+# 3. ``font-src 'self' data:``: the CSS inlines woff2 fonts as ``data:``
+#    URLs, which the ``'self'`` rule alone would refuse.
+# 4. ``img-src 'self'``: card images come from the API's own routes.
+# 5. ``frame-ancestors 'none'``: nothing frames the dashboard.
+# 6. ``base-uri 'self'``: a ``<base>`` from anywhere but this origin
+#    cannot move every relative URL the page loads.
+# 7. ``object-src 'none'``: the page embeds no plugin content.
+CONTENT_SECURITY_POLICY = (
+    "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; "
+    "img-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
+)
+
 _SEPARATORS = re.compile(r"[\\/]+")
 
 
