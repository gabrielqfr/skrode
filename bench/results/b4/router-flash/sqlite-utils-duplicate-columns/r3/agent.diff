+def dedupe_keys(keys: Iterable[str]) -> List[str]:
+    """
+    Renames duplicate keys so that every name is unique, by appending ``_2``,
+    ``_3``... to later occurrences of a duplicate, skipping any suffix that
+    would collide with another column. Use this when converting rows to
+    dictionaries, since duplicates would otherwise silently overwrite each
+    other.
+
+    :param keys: The column names, in order, which may contain duplicates
+    """
+    keys = list(keys)
+    if len(set(keys)) == len(keys):
+        return keys
+    seen: Set[str] = set()
+    deduped: List[str] = []
+    for key in keys:
+        if key in seen:
+            n = 2
+            while "{}_{}".format(key, n) in seen or "{}_{}".format(key, n) in keys:
+                n += 1
+            key = "{}_{}".format(key, n)
+        seen.add(key)
+        deduped.append(key)
+    return deduped
+
