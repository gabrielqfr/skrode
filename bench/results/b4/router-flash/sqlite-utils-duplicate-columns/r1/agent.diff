+def dedupe_keys(keys: Iterable[str]) -> List[str]:
+    """
+    Renames duplicate keys so every name is unique, by appending ``_2``, ``_3``...
+    to later occurrences of a repeated name. Any suffix that would collide with
+    another column is skipped. Use this when converting rows to dictionaries,
+    where duplicate keys would otherwise overwrite each other.
+
+    :param keys: The column names, in order
+    """
+    keys = list(keys)
+    if len(set(keys)) == len(keys):
+        return keys
+    original = set(keys)
+    seen: set = set()
+    result: List[str] = []
+    for key in keys:
+        if key not in seen:
+            seen.add(key)
+            result.append(key)
+            continue
+        n = 2
+        while f"{key}_{n}" in seen or f"{key}_{n}" in original:
+            n += 1
+        new_key = f"{key}_{n}"
+        seen.add(new_key)
+        result.append(new_key)
+    return result
+
