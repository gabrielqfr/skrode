+/** The chips of `options` split into the main field and the long tail:
+ *  `main` holds every option whose share is at least `MAIN_SHARE`, `other`
+ *  the rest (a share missing counts as below). Both keep the order they
+ *  were read in. */
+export function splitOptions(options: ExpectedOption[]): { main: ExpectedOption[]; other: ExpectedOption[] } {
+  const main: ExpectedOption[] = []
+  const other: ExpectedOption[] = []
+  for (const option of options) {
