+class _Level(logging.Filter):
+    """Passes records at ``floor`` and up, and INFO from ``sensei_top.llm``
+    (the generate call's cost line) at any level above INFO."""
+
+    def __init__(self, floor: int) -> None:
+        super().__init__()
+        self.floor = floor
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        if record.levelno >= self.floor:
+            return True
+        if record.levelno < logging.INFO:
+            return False
+        name = record.name
+        return name == "sensei_top.llm" or name.startswith("sensei_top.llm.")
+
+
