+/** The options a chip shows up front (a share of `MAIN_SHARE` or more) and
+ *  the rest, which sit under "Other". Order is kept in both. */
+export function splitOptions(options: ExpectedOption[]): { main: ExpectedOption[]; other: ExpectedOption[] } {
+  const main: ExpectedOption[] = []
+  const other: ExpectedOption[] = []
+  for (const option of options) {
+    if (option.share != null && option.share >= MAIN_SHARE) main.push(option)
+    else other.push(option)
+  }
+  return { main, other }
