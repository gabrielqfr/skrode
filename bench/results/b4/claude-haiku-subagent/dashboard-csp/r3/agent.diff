@@ -51,6 +51,19 @@ from starlette.responses import Response
 from starlette.staticfiles import StaticFiles
 from starlette.types import Scope
 
+# What the dashboard may load, and why each directive is needed:
+# - style-src 'unsafe-inline': React's style={...} props set inline styles.
+# - font-src data:: the CSS inlines its woff2 fonts as data: URLs.
+# - img-src 'self': card images come from the API's own routes, same origin.
+# - script-src is not listed, so it falls back to default-src 'self': no
+#   script is inline, and every script is a built file under the origin.
+# - frame-ancestors, base-uri and object-src lock down framing, <base>
+#   rewriting and plugins, none of which the dashboard uses.
+CONTENT_SECURITY_POLICY = (
+    "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; "
+    "img-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
+)
+
 _SEPARATORS = re.compile(r"[\\/]+")
 
 
