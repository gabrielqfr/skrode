+# TopDeck organisers label Commander nights, drafts, sealed and prerelease
+# events "Standard", so they arrive as Standard constructed. Matched on the
+# tournament name only; the leading boundary alone catches "Pre Release",
+# "Prerelease" and misspellings such as "PreRealese".
+_NOT_CONSTRUCTED_RE = re.compile(
+    r"(?<![a-z])(commander|edh|draft|sealed|cube|jumpstart|pre.?r?e?a?l)",
+    re.IGNORECASE,
+)
+
 # One request line per tournament line in a decklist export: "4 Lightning
 # Bolt" or "4x Lightning Bolt". Fallback path only, for a standings row whose
 # deckObj carries no recognisable Mainboard/Sideboard structure — see
@@ -275,6 +284,40 @@ def _blob_sha(payload: dict[str, Any]) -> str:
     return hashlib.sha256(canonical).hexdigest()
 
 
+def _purge_not_constructed(conn) -> None:
+    """Delete any stored TopDeck event whose name marks it as not Standard
+    constructed, with the rows that hang off it. Runs on every refresh so an
+    event stored before the filter existed is removed too."""
+    rows = conn.execute(
+        "SELECT event_id, name FROM meta_event WHERE event_id LIKE 'Tournaments/Topdeck/%'"
+    ).fetchall()
+    doomed = [
+        event_id
+        for event_id, name in rows
+        if _NOT_CONSTRUCTED_RE.search(str(name or ""))
+    ]
+    if not doomed:
+        return
+    conn.execute("BEGIN")
+    try:
+        for event_id in doomed:
+            conn.execute(
+                "UPDATE meta_event SET duplicate_of = NULL WHERE duplicate_of = ?",
+                (event_id,),
+            )
+            conn.execute("DELETE FROM meta_deck_archetype WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_round_match WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_deck WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_event WHERE event_id = ?", (event_id,))
+        conn.execute("COMMIT")
+    except Exception:
+        conn.execute("ROLLBACK")
+        raise
+    log.warning(
+        "topdeck: purged %d stored event(s) that are not Standard constructed", len(doomed)
+    )
+
