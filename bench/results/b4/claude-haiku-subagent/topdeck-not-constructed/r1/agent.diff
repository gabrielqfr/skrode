+def _purge_not_constructed(conn) -> None:
+    """Delete every stored TopDeck event whose name says it is not Standard
+    constructed, with the rows that hang off it. Runs on every refresh, so
+    events stored before the name filter existed are cleaned up too. Twins
+    pointing at a purged event are released (``duplicate_of = NULL``) rather
+    than deleted, so they are judged afresh on the next corpus build."""
+    rows = conn.execute(
+        "SELECT event_id, name FROM meta_event WHERE event_id LIKE 'Tournaments/Topdeck/%'"
+    ).fetchall()
+    doomed = [
+        row[0] for row in rows if _NOT_CONSTRUCTED_RE.search(str(row[1] or ""))
+    ]
+    if not doomed:
+        return
+    conn.execute("BEGIN")
+    try:
+        for event_id in doomed:
+            conn.execute(
+                "UPDATE meta_event SET duplicate_of = NULL WHERE duplicate_of = ?",
+                (event_id,),
+            )
+            conn.execute("DELETE FROM meta_deck_archetype WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_round_match WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_deck WHERE event_id = ?", (event_id,))
+            conn.execute("DELETE FROM meta_event WHERE event_id = ?", (event_id,))
+        conn.execute("COMMIT")
+    except Exception:
+        conn.execute("ROLLBACK")
+        raise
+    log.warning(
+        "topdeck: purged %d stored event(s) that are not Standard constructed",
+        len(doomed),
+    )
+
