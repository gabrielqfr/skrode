+# TopDeck organisers label Commander, draft, sealed, cube, jumpstart and
+# prerelease events "Standard", so the format field cannot be trusted alone.
+# Leading boundary only: "Pre Release", "Prerelease" and a misspelt
+# "PreRealese" all match, while a name that merely contains "pre" mid-word
+# does not.
+_NOT_CONSTRUCTED_RE = re.compile(
+    r"(?<![a-z])(commander|edh|draft|sealed|cube|jumpstart|pre.?r?e?a?l)",
+    re.IGNORECASE,
+)
+
