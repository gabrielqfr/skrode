+    def _reasoning_refresh_events(
+        self,
+        response_json: dict[str, Any],
+        done_events: dict[str, StreamEvent],
+    ) -> list[StreamEvent]:
+        """Re-issue reasoning metadata from the final ``response.completed``
+        payload onto the parts streamed earlier.
+
+        OpenAI encrypts reasoning per event, so the ciphertext on the
+        ``output_item.done`` event can differ from the one in the final
+        payload. The refresh events carry the final item's id, ciphertext
+        and summary, and share the streamed event's part_index so they
+        merge into the same ReasoningPart.
+        """
+        events: list[StreamEvent] = []
+        for item in response_json.get("output") or []:
+            if not isinstance(item, dict) or item.get("type") != "reasoning":
+                continue
+            prior = done_events.get(item.get("id"))
+            if prior is None or prior.part_index is None:
+                continue
+            meta = {
+                key: item[key]
+                for key in ("id", "encrypted_content", "summary")
+                if item.get(key)
+            }
+            if meta:
+                events.append(
+                    StreamEvent(
+                        type="reasoning",
+                        chunk="",
+                        part_index=prior.part_index,
+                        provider_metadata={"openai": meta},
+                    )
+                )
+        return events
+
 
