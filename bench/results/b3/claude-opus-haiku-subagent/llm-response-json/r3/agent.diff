+    def _reasoning_refresh_events(self, response_json, done_events) -> list[StreamEvent]:
+        """Reasoning events carrying the final payload's ciphertext.
+
+        OpenAI encrypts reasoning per event, so the response.completed
+        payload can hold a different encrypted_content for an item than
+        output_item.done did. Re-emitting its metadata against the same
+        part index lets the stored part agree with response_json. Parts
+        are merged by index, so this does not add a second ReasoningPart.
+        """
+        events: list[StreamEvent] = []
+        for item in response_json.get("output") or []:
+            if not isinstance(item, dict) or item.get("type") != "reasoning":
+                continue
+            prior = done_events.get(item.get("id"))
+            if prior is None or prior.part_index is None:
+                continue
+            meta: dict[str, Any] = {}
+            for key in ("id", "encrypted_content", "summary"):
+                if item.get(key):
+                    meta[key] = item[key]
+            if meta:
+                events.append(
+                    StreamEvent(
+                        type="reasoning",
+                        chunk="",
+                        part_index=prior.part_index,
+                        provider_metadata={"openai": meta},
+                    )
+                )
+        return events
+
 
