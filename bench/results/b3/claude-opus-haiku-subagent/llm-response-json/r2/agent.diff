+    def _reasoning_refresh_events(
+        self, response_json, done_events
+    ) -> list[StreamEvent]:
+        """Re-issue reasoning metadata from the final payload.
+
+        OpenAI encrypts reasoning per event, so the ciphertext in
+        response.completed can differ from the one streamed at
+        output_item.done. The refresh carries the final values so the
+        stored ReasoningPart agrees with response_json. It adds no text.
+        """
+        events: list[StreamEvent] = []
+        for item in response_json.get("output") or []:
+            if not (isinstance(item, dict) and item.get("type") == "reasoning"):
+                continue
+            prior = done_events.get(item.get("id"))
+            if prior is None or prior.part_index is None:
+                continue
+            meta: dict[str, Any] = {}
+            for key in ("id", "encrypted_content", "summary"):
+                if item.get(key):
+                    meta[key] = item[key]
+            if meta:
+                events.append(
+                    StreamEvent(
+                        type="reasoning",
+                        chunk="",
+                        part_index=prior.part_index,
+                        provider_metadata={"openai": meta},
+                    )
+                )
+        return events
+
 
