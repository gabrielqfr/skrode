+# -- condensed provider payloads ----------------------------------------
+#
+# A turn's raw response.json() is stored with long strings and subtrees
+# that the store already holds replaced by {"$": key} references. The
+# replacement dict is never stored: it is rebuilt from the same rows on
+# the way out, so the same walk yields the same keys on both sides.
+
+_CONDENSE_MIN_LENGTH = 64
+
+TURN_TOOLS_SQL = """
+select tools.name, tools.description
+  from turn_tools
+  join tools on tools.id = turn_tools.tool_id
+ where turn_tools.turn_id = ?
+"""
+
+
+def _offer_replacement(replacements: dict[str, Any], key: str, value: Any) -> None:
+    "Offer ``value`` under ``key`` if it is worth a reference."
+    if isinstance(value, str):
+        if len(value) >= _CONDENSE_MIN_LENGTH:
+            replacements[key] = value
+    elif isinstance(value, (dict, list)):
+        if not value:
+            return
+        try:
+            size = len(json.dumps(value, separators=(",", ":")))
+        except (TypeError, ValueError):
+            return
+        if size >= _CONDENSE_MIN_LENGTH:
+            replacements[key] = value
+
+
+def _offer_tree(replacements: dict[str, Any], obj: Any, prefix: str) -> None:
+    "Offer every container and string under ``obj`` by its path."
+    _offer_replacement(replacements, prefix, obj)
+    if isinstance(obj, dict):
+        for key, value in obj.items():
+            _offer_tree(replacements, value, f"{prefix}.{key}")
+    elif isinstance(obj, list):
+        for index, item in enumerate(obj):
+            _offer_tree(replacements, item, f"{prefix}.{index}")
+
+
+def _payload_replacements(
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+) -> dict[str, Any]:
+    """The replacement dict a payload is condensed against.
+
+    Built from the turn's own messages (addressed by message and part
+    index), its tools (name and description), its schema and the model's
+    json_replacements. Only written at condense time and rebuilt
+    identically at read time, so it is never stored.
+    """
+    replacements: dict[str, Any] = {}
+    for mi, message in enumerate(messages):
+        message_dict = message.to_dict()
+        for pi, part in enumerate(message_dict.get("parts", [])):
+            base = f"{mi}.{pi}"
+            _offer_replacement(replacements, f"{base}.text", part.get("text"))
+            _offer_replacement(replacements, f"{base}.output", part.get("output"))
+            arguments = part.get("arguments")
+            if arguments:
+                compact = json.dumps(arguments, separators=(",", ":"))
+                _offer_replacement(replacements, f"{base}.args", compact)
+                pretty = json.dumps(arguments)
+                if pretty != compact:
+                    _offer_replacement(replacements, f"{base}.args2", pretty)
+                _offer_replacement(replacements, f"{base}.argsv", arguments)
+            _offer_tree(
+                replacements,
+                part.get("provider_metadata") or {},
+                f"{base}.pm",
+            )
+        _offer_tree(
+            replacements,
+            message_dict.get("provider_metadata") or {},
+            f"{mi}.pm",
+        )
+
+    # A name seen with two different descriptions is ambiguous, so it is
+    # dropped whatever order the pairs arrive in.
+    descriptions: dict[str, set[str]] = {}
+    for name, description in tools:
+        if (
+            name
+            and isinstance(description, str)
+            and len(description) >= _CONDENSE_MIN_LENGTH
+        ):
+            descriptions.setdefault(name, set()).add(description)
+    for name, values in descriptions.items():
+        if len(values) == 1:
+            replacements[f"tool.{name}.description"] = next(iter(values))
+
+    _offer_replacement(replacements, "schema", schema)
+
+    for key, value in (model_replacements or {}).items():
+        replacements[f"m.{key}"] = value
+    return replacements
+
+
+def condense_payload(
+    payload,
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+) -> str | None:
+    "Condense a raw provider payload for storage, or None if there is none."
+    if payload is None:
+        return None
+    replacements = _payload_replacements(messages, tools, schema, model_replacements)
+    return json.dumps(condense_json(payload, replacements))
+
+
+def resolve_payload(
+    condensed,
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+):
+    """Reverse condense_payload. Raises UncondenseError if a reference
+    no longer resolves against the rows it was built from."""
+    if condensed is None:
+        return None
+    replacements = _payload_replacements(messages, tools, schema, model_replacements)
+    return uncondense_json(json.loads(condensed), replacements)
+
+
+def _model_json_replacements(model_id: str | None) -> dict[str, Any] | None:
+    """The json_replacements of the model that produced a turn, looked up
+    again at read time. None if the model is no longer installed, so
+    markers that depended on it fail with UncondenseError."""
+    if not model_id:
+        return None
+    # Imported here: llm imports this module, so a top-level import
+    # would be circular.
+    from llm import UnknownModelError, get_model
+
+    try:
+        model = get_model(model_id)
+    except UnknownModelError:
+        return None
+    return getattr(model, "json_replacements", None)
+
+
 def _now() -> str:
     return str(datetime.datetime.now(datetime.timezone.utc))
 
