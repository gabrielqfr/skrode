diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..bd76177b
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,152 @@
+"""
+Supervision for long-lived background tasks registered by plugins via
+``datasette.add_background_task()``.
+
+Tasks are registered (usually from a ``startup`` hook) and launched by core
+only after every ``startup`` hook has finished. The supervisor keeps a
+reference to each task, logs crashes with their traceback and can cancel
+them all.
+"""
+
+import asyncio
+import datetime
+import logging
+import types
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+def _utcnow_iso():
+    return datetime.datetime.now(datetime.timezone.utc).isoformat()
+
+
+class BackgroundTask:
+    """Handle for a background task registered with a BackgroundTaskSupervisor.
+
+    States: ``registered`` -> ``running`` -> ``completed`` | ``crashed`` |
+    ``cancelled``.
+    """
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        if self.task is not None:
+            # State becomes "cancelled" later, in the done callback
+            self.task.cancel()
+        elif self._supervisor is not None:
+            # Not launched yet: deregister so it never runs
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    """Owns the background tasks registered for a single Datasette instance."""
+
+    def __init__(self, datasette):
+        self.datasette = datasette
+        self._handles = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def add(self, func, name=None):
+        base = name or getattr(func, "__qualname__", None) or repr(func)
+        candidate = base
+        n = 2
+        while candidate in self._names:
+            candidate = f"{base}-{n}"
+            n += 1
+        plugin = self._plugin_name_for(func)
+        handle = BackgroundTask(candidate, func, plugin=plugin)
+        handle._supervisor = self
+        self._names.add(candidate)
+        self._handles.append(handle)
+        if self._launched:
+            self._launch(handle)
+        return handle
+
+    def _plugin_name_for(self, func):
+        try:
+            from datasette.plugins import pm
+
+            module = getattr(func, "__module__", None)
+            if not module:
+                return None
+            for plugin in pm.get_plugins():
+                if isinstance(plugin, types.ModuleType):
+                    plugin_module = plugin.__name__
+                else:
+                    plugin_module = type(plugin).__module__
+                if module == plugin_module or module.startswith(plugin_module + "."):
+                    return pm.get_name(plugin)
+            return None
+        except Exception:
+            return None
+
+    def _remove(self, handle):
+        if handle in self._handles:
+            self._handles.remove(handle)
+        self._names.discard(handle.name)
+
+    async def launch_all(self):
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in list(self._handles):
+                if handle.task is None:
+                    self._launch(handle)
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = _utcnow_iso()
+        handle.task = asyncio.create_task(
+            handle._func(self.datasette), name=handle.name
+        )
+
+        def _done(task, handle=handle):
+            if task.cancelled():
+                handle.state = "cancelled"
+                return
+            exc = task.exception()
+            if exc is not None:
+                handle.state = "crashed"
+                handle.exception = exc
+                logger.error("Background task %r crashed", handle.name, exc_info=exc)
+            else:
+                handle.state = "completed"
+
+        handle.task.add_done_callback(_done)
+
+    async def cancel_all(self, grace: float = 5.0):
+        pending = [
+            h.task for h in self._handles if h.task is not None and not h.task.done()
+        ]
+        if not pending:
+            return
+        for task in pending:
+            task.cancel()
+        _, still_running = await asyncio.wait(pending, timeout=grace)
+        if still_running:
+            names = sorted(t.get_name() for t in still_running)
+            logger.warning(
+                "%d background task(s) still running %s seconds after cancellation: %s",
+                len(names),
+                grace,
+                ", ".join(names),
+            )
+
+    def tasks(self):
+        return list(self._handles)
