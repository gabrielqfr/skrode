diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..aff90334
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,147 @@
+"""
+Supervised background tasks registered via ``datasette.add_background_task()``.
+
+Handles are registered at any time, but only launched once
+``BackgroundTaskSupervisor.launch_all()`` runs (after every ``startup`` hook).
+"""
+
+import asyncio
+import datetime
+import inspect
+import logging
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+class BackgroundTask:
+    """Handle for one background task."""
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        if self.task is not None:
+            # The state becomes "cancelled" later, in the done callback
+            self.task.cancel()
+        elif self._supervisor is not None:
+            # Not yet launched: drop it so it never runs
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    """Owns every background task registered with one Datasette instance."""
+
+    def __init__(self, datasette):
+        self.datasette = datasette
+        self._handles = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def add(self, func, name=None):
+        base = name or getattr(func, "__qualname__", None) or repr(func)
+        unique = base
+        n = 2
+        while unique in self._names:
+            unique = f"{base}-{n}"
+            n += 1
+        handle = BackgroundTask(unique, func, plugin=self._plugin_for(func))
+        handle._supervisor = self
+        self._names.add(unique)
+        self._handles.append(handle)
+        if self._launched:
+            self._launch(handle)
+        return handle
+
+    def _plugin_for(self, func):
+        # Imported here: datasette.plugins imports the package, which imports
+        # this module, so a top-level import would be circular.
+        from .plugins import pm
+
+        try:
+            module = func.__module__
+            for plugin in pm.get_plugins():
+                plugin_name = pm.get_name(plugin)
+                if inspect.ismodule(plugin):
+                    plugin_module = plugin.__name__
+                else:
+                    plugin_module = getattr(plugin, "__module__", None)
+                if not plugin_module or not module:
+                    continue
+                if module == plugin_module or module.startswith(plugin_module + "."):
+                    return plugin_name
+        except Exception:
+            return None
+        return None
+
+    def _remove(self, handle):
+        if handle in self._handles:
+            self._handles.remove(handle)
+            self._names.discard(handle.name)
+
+    async def launch_all(self):
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in list(self._handles):
+                if handle.task is None:
+                    self._launch(handle)
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = (
+            datetime.datetime.now(datetime.timezone.utc).isoformat()
+        )
+        handle.task = asyncio.create_task(
+            handle._func(self.datasette), name=handle.name
+        )
+
+        def _done(task, handle=handle):
+            if task.cancelled():
+                handle.state = "cancelled"
+                return
+            exc = task.exception()
+            if exc is not None:
+                handle.exception = exc
+                handle.state = "crashed"
+                logger.error("Background task %r crashed", handle.name, exc_info=exc)
+            else:
+                handle.state = "completed"
+
+        handle.task.add_done_callback(_done)
+
+    async def cancel_all(self, grace: float = 5.0):
+        handles = [
+            h for h in self._handles if h.task is not None and not h.task.done()
+        ]
+        if not handles:
+            return
+        for h in handles:
+            h.task.cancel()
+        _, still_pending = await asyncio.wait(
+            [h.task for h in handles], timeout=grace
+        )
+        if still_pending:
+            names = sorted(h.name for h in handles if h.task in still_pending)
+            logger.warning(
+                "%d background task(s) still running after %ss grace period: %s",
+                len(names),
+                grace,
+                ", ".join(names),
+            )
+
+    def tasks(self):
+        return list(self._handles)
