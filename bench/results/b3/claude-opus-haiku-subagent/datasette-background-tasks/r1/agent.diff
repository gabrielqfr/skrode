diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..c356ff5a
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,152 @@
+"""
+Supervised background tasks.
+
+Plugins register long-lived work with ``datasette.add_background_task()``.
+The supervisor keeps a reference to every launched task, logs crashes with
+their traceback and can cancel them all.
+"""
+
+import asyncio
+import datetime
+import logging
+import types
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+class BackgroundTask:
+    """Handle for a single registered background task."""
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        if self.task is not None:
+            # State becomes "cancelled" later, in the done callback
+            self.task.cancel()
+        elif self._supervisor is not None:
+            # Not launched yet: deregister so it never runs
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    """Owns the background tasks registered for a single Datasette instance."""
+
+    def __init__(self, datasette):
+        self._datasette = datasette
+        self._handles = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def add(self, func, name=None):
+        base = name or getattr(func, "__qualname__", None) or repr(func)
+        final = base
+        n = 2
+        while final in self._names:
+            final = f"{base}-{n}"
+            n += 1
+        handle = BackgroundTask(final, func, plugin=self._plugin_for(func))
+        handle._supervisor = self
+        self._handles.append(handle)
+        self._names.add(final)
+        if self._launched:
+            self._launch(handle)
+        return handle
+
+    def _plugin_for(self, func):
+        try:
+            from datasette.plugins import pm
+
+            func_module = getattr(func, "__module__", None)
+            if not func_module:
+                return None
+            for plugin_name, plugin in pm.list_name_plugin():
+                plugin_module = _plugin_module_name(plugin)
+                if plugin_module and (
+                    func_module == plugin_module
+                    or func_module.startswith(plugin_module + ".")
+                ):
+                    return plugin_name
+        except Exception:
+            return None
+        return None
+
+    def _remove(self, handle):
+        if handle in self._handles:
+            self._handles.remove(handle)
+            self._names.discard(handle.name)
+
+    async def launch_all(self):
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in list(self._handles):
+                if handle.task is None:
+                    self._launch(handle)
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = (
+            datetime.datetime.now(datetime.timezone.utc).isoformat()
+        )
+        handle.task = asyncio.create_task(
+            handle._func(self._datasette), name=handle.name
+        )
+
+        def _on_done(task):
+            if task.cancelled():
+                handle.state = "cancelled"
+                return
+            exc = task.exception()
+            if exc is not None:
+                handle.exception = exc
+                handle.state = "crashed"
+                logger.error("Background task %r crashed", handle.name, exc_info=exc)
+            else:
+                handle.state = "completed"
+
+        handle.task.add_done_callback(_on_done)
+
+    async def cancel_all(self, grace=5.0):
+        pending = [
+            h.task for h in self._handles if h.task is not None and not h.task.done()
+        ]
+        if not pending:
+            return
+        for task in pending:
+            task.cancel()
+        await asyncio.wait(pending, timeout=grace)
+        stragglers = sorted(
+            h.name for h in self._handles if h.task is not None and not h.task.done()
+        )
+        if stragglers:
+            logger.warning(
+                "%d background task(s) still running after %ss grace period: %s",
+                len(stragglers),
+                grace,
+                ", ".join(stragglers),
+            )
+
+    def tasks(self):
+        return list(self._handles)
+
+
+def _plugin_module_name(plugin):
+    """Return the module name a pluggy plugin (module or object) belongs to."""
+    if isinstance(plugin, types.ModuleType):
+        return plugin.__name__
+    return getattr(type(plugin), "__module__", None) or None
