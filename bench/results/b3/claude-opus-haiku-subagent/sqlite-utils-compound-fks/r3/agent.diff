+@dataclass(order=True)
+class ForeignKey:
+    """
+    A foreign key. ``column``/``other_column`` hold the single column of a
+    single-column key and are ``None`` for a compound key, which uses
+    ``columns``/``other_columns`` instead.
+    """
+
+    table: str
+    column: Optional[str] = field(compare=False)
+    other_table: str
+    other_column: Optional[str] = field(compare=False)
+    columns: Tuple[str, ...] = ()
+    other_columns: Tuple[str, ...] = ()
+    is_compound: bool = False
+    on_delete: str = "NO ACTION"
+    on_update: str = "NO ACTION"
+
+    def __post_init__(self):
+        if self.columns:
+            self.columns = tuple(self.columns)
+        else:
+            self.columns = (self.column,) if self.column is not None else ()
+        if self.other_columns:
+            self.other_columns = tuple(self.other_columns)
+        else:
+            self.other_columns = (
+                (self.other_column,) if self.other_column is not None else ()
+            )
+
+
+def _fk_actions_sql(fk: "ForeignKey") -> str:
+    "SQL for the ON UPDATE / ON DELETE clauses of a foreign key, if any."
+    sql = ""
+    if fk.on_update and fk.on_update != "NO ACTION":
+        sql += " ON UPDATE {}".format(fk.on_update)
+    if fk.on_delete and fk.on_delete != "NO ACTION":
+        sql += " ON DELETE {}".format(fk.on_delete)
+    return sql
+
+
+def _fk_matches_drop(fk: "ForeignKey", drop_foreign_keys: Iterable) -> bool:
+    "Does a drop_foreign_keys item match this foreign key?"
+    for item in drop_foreign_keys:
+        if isinstance(item, str):
+            # A bare column name matches any key that column belongs to
+            if item in fk.columns:
+                return True
+        elif tuple(item) == fk.columns:
+            # A tuple must match the full key
+            return True
+    return False
+
+
+def _fk_renamed(
+    fk: "ForeignKey", table: str, rename: Dict[str, str]
+) -> "ForeignKey":
+    "Copy of a foreign key with its local columns renamed. other_columns never change."
+    columns = tuple(rename.get(c) or c for c in fk.columns)
+    single = not fk.is_compound
+    return ForeignKey(
+        table=table,
+        column=columns[0] if single else None,
+        other_table=fk.other_table,
+        other_column=fk.other_column if single else None,
+        columns=columns,
+        other_columns=fk.other_columns,
+        is_compound=fk.is_compound,
+        on_delete=fk.on_delete,
+        on_update=fk.on_update,
+    )
+
