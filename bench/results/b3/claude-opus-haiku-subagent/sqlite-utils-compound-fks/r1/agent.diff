+@dataclass(order=True)
+class ForeignKey:
+    """
+    A foreign key constraint. ``column`` and ``other_column`` hold the single
+    column for an ordinary key; a compound key has ``None`` in both and lists
+    its member columns in ``columns`` and ``other_columns``.
+    """
+
+    table: str
+    column: Optional[str] = field(compare=False)
+    other_table: str
+    other_column: Optional[str] = field(compare=False)
+    columns: Tuple[str, ...] = ()
+    other_columns: Tuple[str, ...] = ()
+    is_compound: bool = False
+    on_delete: str = "NO ACTION"
+    on_update: str = "NO ACTION"
+
+    def __post_init__(self):
+        if self.columns:
+            self.columns = tuple(self.columns)
+        elif self.column is not None:
+            self.columns = (self.column,)
+        else:
+            self.columns = ()
+        if self.other_columns:
+            self.other_columns = tuple(self.other_columns)
+        elif self.other_column is not None:
+            self.other_columns = (self.other_column,)
+        else:
+            self.other_columns = ()
+
+
+def _fk_actions_sql(fk: ForeignKey) -> str:
+    "SQL for any non-default ON UPDATE / ON DELETE actions, ON UPDATE first."
+    sql = ""
+    if fk.on_update and fk.on_update != "NO ACTION":
+        sql += " ON UPDATE {}".format(fk.on_update)
+    if fk.on_delete and fk.on_delete != "NO ACTION":
+        sql += " ON DELETE {}".format(fk.on_delete)
+    return sql
+
+
+def _fk_matches_drop(fk: ForeignKey, item: Any) -> bool:
+    "Does a drop_foreign_keys item (a column name or a tuple of columns) match fk?"
+    if isinstance(item, (list, tuple)):
+        return tuple(item) == fk.columns
+    return item in fk.columns
+
+
+def _rename_fk(fk: ForeignKey, table_name: str, rename: dict) -> ForeignKey:
+    "Copy fk onto table_name, applying column renames to its local columns only."
+    new_columns = tuple(rename.get(c) or c for c in fk.columns)
+    single = not fk.is_compound
+    return ForeignKey(
+        table=table_name,
+        column=new_columns[0] if single else None,
+        other_table=fk.other_table,
+        other_column=fk.other_column if single else None,
+        columns=new_columns,
+        other_columns=fk.other_columns,
+        is_compound=fk.is_compound,
+        on_delete=fk.on_delete,
+        on_update=fk.on_update,
+    )
+
