+# -- condensed provider payloads ---------------------------------------
+#
+# The raw provider payload is worth keeping, but most of it is a second
+# copy of things the store already holds: the turn's own messages, its
+# tools, its schema and any model-level boilerplate. condense-json
+# replaces those subtrees with {"$": key} references, and the very same
+# replacement dict is rebuilt at read time from the same rows, so write
+# and read walk the identical object.
+
+_CONDENSE_MIN_LENGTH = 64
+
+TURN_TOOLS_SQL = """
+select tools.name, tools.description
+from turn_tools
+join tools on tools.id = turn_tools.tool_id
+where turn_tools.turn_id = ?
+"""
+
+
+def _is_offered(value: Any) -> bool:
+    """Whether a value is worth replacing with a reference.
+
+    Long strings match as substrings; non-empty dicts and lists match
+    structurally when their compact serialization is long enough. Short
+    values and scalars would cost as much as they save, so they are
+    never offered. Values that cannot be serialized are skipped.
+    """
+    if isinstance(value, str):
+        return len(value) >= _CONDENSE_MIN_LENGTH
+    if isinstance(value, (dict, list)):
+        if not value:
+            return False
+        try:
+            dumped = json.dumps(value, separators=(",", ":"))
+        except (TypeError, ValueError):
+            return False
+        return len(dumped) >= _CONDENSE_MIN_LENGTH
+    return False
+
+
+def _walk_replacements(replacements: dict[str, Any], obj: Any, prefix: str) -> None:
+    if isinstance(obj, dict):
+        if _is_offered(obj):
+            replacements[prefix] = obj
+        for key, value in obj.items():
+            _walk_replacements(replacements, value, f"{prefix}.{key}")
+    elif isinstance(obj, list):
+        if _is_offered(obj):
+            replacements[prefix] = obj
+        for index, value in enumerate(obj):
+            _walk_replacements(replacements, value, f"{prefix}.{index}")
+    elif _is_offered(obj):
+        replacements[prefix] = obj
+
+
+def _payload_replacements(
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+) -> dict[str, Any]:
+    """Build the replacement dict shared by condensing and resolving.
+
+    It is derived purely from the turn's own rows - the chain segment it
+    appended, the tools and schema it was given and the model's declared
+    boilerplate dictionary - so condense_payload and resolve_payload
+    build byte-identical dicts from the same inputs.
+    """
+    replacements: dict[str, Any] = {}
+
+    for mi, message in enumerate(messages):
+        message_dict = message.to_dict()
+        for pi, part in enumerate(message_dict.get("parts", []) or []):
+            base = f"{mi}.{pi}"
+            if _is_offered(part.get("text")):
+                replacements[f"{base}.text"] = part["text"]
+            if _is_offered(part.get("output")):
+                replacements[f"{base}.output"] = part["output"]
+            arguments = part.get("arguments")
+            if arguments:
+                compact = json.dumps(arguments, separators=(",", ":"))
+                default = json.dumps(arguments)
+                if len(compact) >= _CONDENSE_MIN_LENGTH:
+                    replacements[f"{base}.args"] = compact
+                if default != compact and len(default) >= _CONDENSE_MIN_LENGTH:
+                    replacements[f"{base}.args2"] = default
+                if _is_offered(arguments):
+                    replacements[f"{base}.argsv"] = arguments
+            _walk_replacements(
+                replacements, part.get("provider_metadata") or {}, f"{base}.pm"
+            )
+        _walk_replacements(
+            replacements, message_dict.get("provider_metadata") or {}, f"{mi}.pm"
+        )
+
+    seen_descriptions: dict[str, set] = {}
+    for name, description in tools or ():
+        if not name or not isinstance(description, str):
+            continue
+        if len(description) < _CONDENSE_MIN_LENGTH:
+            continue
+        seen_descriptions.setdefault(name, set()).add(description)
+    for name, descriptions in seen_descriptions.items():
+        if len(descriptions) == 1:
+            replacements[f"tool.{name}.description"] = next(iter(descriptions))
+
+    if schema:
+        if _is_offered(schema):
+            replacements["schema"] = schema
+
+    for key, value in (model_replacements or {}).items():
+        replacements[f"m.{key}"] = value
+
+    return replacements
+
+
+def condense_payload(
+    payload, messages, tools=(), schema=None, model_replacements=None
+) -> str | None:
+    if payload is None:
+        return None
+    return json.dumps(
+        condense_json(
+            payload,
+            _payload_replacements(
+                messages, tools=tools, schema=schema,
+                model_replacements=model_replacements,
+            ),
+        )
+    )
+
+
+def resolve_payload(
+    condensed, messages, tools=(), schema=None, model_replacements=None
+):
+    if condensed is None:
+        return None
+    return uncondense_json(
+        json.loads(condensed),
+        _payload_replacements(
+            messages, tools=tools, schema=schema,
+            model_replacements=model_replacements,
+        ),
+    )
+
+
+def _model_json_replacements(model_id):
+    if not model_id:
+        return None
+    from llm import UnknownModelError, get_model
+
+    try:
+        model = get_model(model_id)
+    except UnknownModelError:
+        return None
+    return getattr(model, "json_replacements", None)
+
+
 def _now() -> str:
     return str(datetime.datetime.now(datetime.timezone.utc))
 
