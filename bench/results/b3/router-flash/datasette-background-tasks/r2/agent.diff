diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..22b18780
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,169 @@
+"""Supervision for long-lived background tasks registered by plugins.
+
+Plugins call ``datasette.add_background_task(func, name=None)`` (usually from a
+``startup`` hook) to hand a coroutine function over to Datasette. The
+:class:`BackgroundTaskSupervisor` owns the resulting tasks: it keeps a strong
+reference to each one (so it can't be garbage collected mid-flight), launches
+them all only after every ``startup`` hook has finished, records their final
+state, logs crashes with their traceback and can cancel them all.
+"""
+
+import asyncio
+import inspect
+import logging
+from datetime import datetime, timezone
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+class BackgroundTask:
+    """A handle to a supervised background task.
+
+    States move from ``registered`` to ``running`` and then finish in one of
+    ``completed`` (the coroutine returned), ``crashed`` (it raised anything
+    other than ``CancelledError``) or ``cancelled``.
+    """
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        """Cancel this task, or deregister it if it has not launched yet."""
+        if self.task is not None:
+            self.task.cancel()
+            # The state turns "cancelled" later, in the done callback.
+        elif self._supervisor is not None:
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    """Owns every background task registered against one ``Datasette``."""
+
+    def __init__(self, datasette):
+        self.datasette = datasette
+        self._tasks = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def add(self, func, name=None):
+        """Register ``func`` and return its :class:`BackgroundTask` handle."""
+        base_name = name
+        if base_name is None:
+            base_name = getattr(func, "__qualname__", None) or repr(func)
+        resolved_name = base_name
+        if resolved_name in self._names:
+            index = 2
+            while f"{base_name}-{index}" in self._names:
+                index += 1
+            resolved_name = f"{base_name}-{index}"
+        plugin = self._plugin_for(func)
+        handle = BackgroundTask(resolved_name, func, plugin=plugin)
+        handle._supervisor = self
+        self._tasks.append(handle)
+        self._names.add(resolved_name)
+        if self._launched:
+            # Registered after launch: start it straight away.
+            self._launch(handle)
+        return handle
+
+    def _remove(self, handle):
+        try:
+            self._tasks.remove(handle)
+        except ValueError:
+            pass
+        self._names.discard(handle.name)
+
+    def _plugin_for(self, func):
+        """Best-effort pluggy name of the plugin that owns ``func``."""
+        try:
+            from datasette.plugins import pm
+
+            func_module = getattr(func, "__module__", None)
+            if not func_module:
+                return None
+            for plugin in pm.get_plugins():
+                if inspect.ismodule(plugin):
+                    module_name = getattr(plugin, "__name__", None)
+                else:
+                    module_name = getattr(plugin, "__module__", None) or getattr(
+                        type(plugin), "__module__", None
+                    )
+                if not module_name:
+                    continue
+                if func_module == module_name or func_module.startswith(
+                    module_name + "."
+                ):
+                    return pm.get_name(plugin)
+            return None
+        except Exception:  # noqa: BLE001 - attribution is best effort
+            return None
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = datetime.now(timezone.utc).isoformat()
+        task = asyncio.create_task(handle._func(self.datasette), name=handle.name)
+        handle.task = task
+        task.add_done_callback(lambda finished: self._done(handle, finished))
+
+    def _done(self, handle, task):
+        if task.cancelled():
+            handle.state = "cancelled"
+            return
+        exc = task.exception()
+        if exc is not None:
+            handle.state = "crashed"
+            handle.exception = exc
+            logger.error("Background task %r crashed", handle.name, exc_info=exc)
+        else:
+            handle.state = "completed"
+
+    async def launch_all(self):
+        """Launch every registered task; idempotent and concurrency safe."""
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in self._tasks:
+                if handle.task is None:
+                    self._launch(handle)
+
+    async def cancel_all(self, grace: float = 5.0):
+        """Cancel every launched task that has not finished yet."""
+        pending = [
+            handle.task
+            for handle in self._tasks
+            if handle.task is not None and not handle.task.done()
+        ]
+        if not pending:
+            return
+        for task in pending:
+            task.cancel()
+        done, still_pending = await asyncio.wait(pending, timeout=grace)
+        if still_pending:
+            names = sorted(
+                handle.name for handle in self._tasks if handle.task in still_pending
+            )
+            logger.warning(
+                "%d background task(s) still running after the %s second grace "
+                "period: %s",
+                len(still_pending),
+                grace,
+                ", ".join(names),
+            )
+
+    def tasks(self):
+        """A copy of the handle list, in registration order."""
+        return list(self._tasks)
