diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..305de77b
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,173 @@
+"""Supervisor for long-lived background tasks registered by plugins.
+
+Plugins (usually from a ``startup`` hook) call
+``datasette.add_background_task(func, name=None)`` to hand a coroutine
+function to Datasette.  The supervisor keeps a reference to every task so it
+cannot be garbage collected mid-flight, launches them only after every
+``startup`` hook has finished, logs crashes with their traceback and can
+cancel them all.
+"""
+
+import asyncio
+import logging
+from datetime import datetime, timezone
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+class BackgroundTask:
+    """A handle for a background task registered with a supervisor.
+
+    States move from ``registered`` to ``running`` and then to exactly one of
+    ``completed``, ``crashed`` or ``cancelled``.
+    """
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        if self.task is not None:
+            # The done callback set on the task will move the state to
+            # "cancelled" once the cancellation has been processed.
+            self.task.cancel()
+        elif self._supervisor is not None:
+            # Never launched: deregister so it will never be launched.
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    """Owns every background task registered against one Datasette instance."""
+
+    def __init__(self, datasette):
+        self.datasette = datasette
+        self._handles = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def tasks(self):
+        """A copy of the registered handles, in registration order."""
+        return list(self._handles)
+
+    def add(self, func, name=None):
+        """Register ``func`` and return its BackgroundTask handle.
+
+        If the supervisor has already launched then the task starts straight
+        away, returning a handle in state ``running``.
+        """
+        base_name = name or getattr(func, "__qualname__", None) or repr(func)
+        chosen_name = base_name
+        if chosen_name in self._names:
+            counter = 2
+            while f"{base_name}-{counter}" in self._names:
+                counter += 1
+            chosen_name = f"{base_name}-{counter}"
+        handle = BackgroundTask(chosen_name, func, plugin=self._plugin_name(func))
+        handle._supervisor = self
+        self._handles.append(handle)
+        self._names.add(chosen_name)
+        if self._launched:
+            self._launch(handle)
+        return handle
+
+    def _remove(self, handle):
+        if handle in self._handles:
+            self._handles.remove(handle)
+        self._names.discard(handle.name)
+
+    def _plugin_name(self, func):
+        try:
+            from datasette.plugins import pm
+
+            func_module = getattr(func, "__module__", None)
+            if not func_module:
+                return None
+            for plugin in pm.get_plugins():
+                plugin_module = getattr(plugin, "__module__", None) or getattr(
+                    plugin, "__name__", None
+                )
+                if not plugin_module:
+                    continue
+                if func_module == plugin_module or func_module.startswith(
+                    plugin_module + "."
+                ):
+                    return pm.get_name(plugin)
+            return None
+        except Exception:
+            return None
+
+    async def launch_all(self):
+        """Launch every registered task exactly once, in registration order.
+
+        Idempotent and safe to call concurrently.
+        """
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in list(self._handles):
+                if handle.task is None:
+                    self._launch(handle)
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = datetime.now(timezone.utc).isoformat()
+        handle.task = asyncio.create_task(handle._func(self.datasette), name=handle.name)
+        handle.task.add_done_callback(
+            lambda task, handle=handle: self._task_done(handle, task)
+        )
+
+    def _task_done(self, handle, task):
+        if task.cancelled():
+            handle.state = "cancelled"
+            return
+        exc = task.exception()
+        if exc is not None:
+            handle.exception = exc
+            handle.state = "crashed"
+            # A crash never touches other tasks - it is only recorded here.
+            logger.error("Background task %r crashed", handle.name, exc_info=exc)
+        else:
+            handle.state = "completed"
+
+    async def cancel_all(self, grace: float = 5.0):
+        """Cancel every launched task that has not already finished.
+
+        Waits at most ``grace`` seconds for them to come to a stop and logs a
+        warning listing any that outlive that grace period.
+        """
+        pending = [
+            handle.task
+            for handle in self._handles
+            if handle.task is not None and not handle.task.done()
+        ]
+        if not pending:
+            return
+        for task in pending:
+            task.cancel()
+        _, still_pending = await asyncio.wait(pending, timeout=grace)
+        if still_pending:
+            names = sorted(
+                handle.name
+                for handle in self._handles
+                if handle.task in still_pending
+            )
+            logger.warning(
+                "%d background task(s) still running after the %.1fs grace "
+                "period: %s",
+                len(still_pending),
+                grace,
+                ", ".join(names),
+            )
