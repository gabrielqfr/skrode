+def _check_constraint_sql(check: Check) -> str:
+    "SQL for a CHECK constraint, including its name if it has one."
+    sql = ""
+    if check.name:
+        sql += f"CONSTRAINT {quote_identifier(check.name)} "
+    sql += f"CHECK ({check.check}"
+    if sql_ends_in_line_comment(check.check):
+        sql += "\n)"
+    else:
+        sql += ")"
+    return sql
+
+
+def _column_definition_with_comments(
+    definition: str, comments: ColumnComments | None
+) -> str:
+    """
+    Wrap a column definition in the comments that were found before and after
+    it in the original ``CREATE TABLE`` statement.
+    """
+    if comments is None:
+        return definition
+    before = textwrap.dedent(comments.before).strip()
+    after = textwrap.dedent(comments.after).strip()
+    if before:
+        definition = textwrap.indent(before, "   ") + "\n" + definition
+    if after:
+        definition = definition + " " + after
+        if sql_ends_in_line_comment(after):
+            definition += "\n"
+    return definition
+
