+def _check_constraint_sql(check: Check) -> str:
+    "Render a CHECK constraint for a CREATE TABLE statement."
+    prefix = f"CONSTRAINT {quote_identifier(check.name)} " if check.name else ""
+    if sql_ends_in_line_comment(check.check):
+        return f"{prefix}CHECK ({check.check}\n)"
+    return f"{prefix}CHECK ({check.check})"
