+def _column_definition_with_comments(
+    definition: str, comments: ColumnComments
+) -> str:
+    "Wrap a column definition with the comments that belong to it."
+    if comments.before:
+        before = textwrap.dedent(comments.before).strip()
+        before = "\n".join("   " + line for line in before.splitlines())
+        definition = before + "\n" + definition
+    if comments.after:
+        after = textwrap.dedent(comments.after).strip()
+        definition = definition + " " + after
+        if sql_ends_in_line_comment(after):
+            definition += "\n"
+    return definition
