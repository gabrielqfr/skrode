@@ -785,6 +831,114 @@ def _load(value: str | None) -> dict | None:
     return json.loads(value) if value else None
 
 
+_CONDENSE_MIN_LENGTH = 64
+
+TURN_TOOLS_SQL = """
+select tools.name, tools.description
+from turn_tools
+join tools on tools.id = turn_tools.tool_id
+where turn_tools.turn_id = ?
+"""
+
+
+def _offer(found: dict[str, Any], key: str, value: Any) -> None:
+    if isinstance(value, str):
+        if len(value) >= _CONDENSE_MIN_LENGTH:
+            found[key] = value
+    elif isinstance(value, (dict, list)) and value:
+        try:
+            size = len(json.dumps(value, separators=(",", ":")))
+        except (TypeError, ValueError):
+            return
+        if size >= _CONDENSE_MIN_LENGTH:
+            found[key] = value
+
+
+def _walk(found: dict[str, Any], prefix: str, obj: Any) -> None:
+    _offer(found, prefix, obj)
+    if isinstance(obj, dict):
+        for key, value in obj.items():
+            _walk(found, f"{prefix}.{key}", value)
+    elif isinstance(obj, list):
+        for index, value in enumerate(obj):
+            _walk(found, f"{prefix}.{index}", value)
+
+
+def _payload_replacements(
+    messages, tools=(), schema=None, model_replacements=None
+) -> dict[str, Any]:
+    found: dict[str, Any] = {}
+    for mi, message in enumerate(messages):
+        message_dict = message.to_dict()
+        for pi, part in enumerate(message_dict.get("parts", [])):
+            base = f"{mi}.{pi}"
+            _offer(found, f"{base}.text", part.get("text"))
+            _offer(found, f"{base}.output", part.get("output"))
+            arguments = part.get("arguments")
+            if arguments:
+                compact = json.dumps(arguments, separators=(",", ":"))
+                _offer(found, f"{base}.args", compact)
+                spaced = json.dumps(arguments)
+                if spaced != compact:
+                    _offer(found, f"{base}.args2", spaced)
+                _offer(found, f"{base}.argsv", arguments)
+            _walk(found, f"{base}.pm", part.get("provider_metadata") or {})
+        _walk(found, f"{mi}.pm", message_dict.get("provider_metadata") or {})
+    descriptions: dict[str, str] = {}
+    conflicting: set[str] = set()
+    for name, description in tools:
+        if (
+            not name
+            or not isinstance(description, str)
+            or len(description) < _CONDENSE_MIN_LENGTH
+        ):
+            continue
+        if descriptions.setdefault(name, description) != description:
+            conflicting.add(name)
+    for name, description in descriptions.items():
+        if name not in conflicting:
+            found[f"tool.{name}.description"] = description
+    if schema:
+        _offer(found, "schema", schema)
+    for key, value in (model_replacements or {}).items():
+        found[f"m.{key}"] = value
+    return found
+
+
+def condense_payload(
+    payload, messages, tools=(), schema=None, model_replacements=None
+) -> str | None:
+    if payload is None:
+        return None
+    return json.dumps(
+        condense_json(
+            payload,
+            _payload_replacements(messages, tools, schema, model_replacements),
+        )
+    )
+
+
+def resolve_payload(condensed, messages, tools=(), schema=None, model_replacements=None):
+    if condensed is None:
+        return None
+    return uncondense_json(
+        json.loads(condensed),
+        _payload_replacements(messages, tools, schema, model_replacements),
+    )
+
+
+def _model_json_replacements(model_id):
+    if not model_id:
+        return None
+    from llm import UnknownModelError, get_model
+
+    try:
+        model = get_model(model_id)
+    except UnknownModelError:
+        return None
+    return getattr(model, "json_replacements", None) or None
+
+
 def _now() -> str:
     return str(datetime.datetime.now(datetime.timezone.utc))
 
