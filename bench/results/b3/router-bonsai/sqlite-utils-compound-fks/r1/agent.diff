+def _fk_actions_sql(fk: "ForeignKey") -> str:
+    """
+    Return the ``ON UPDATE`` / ``ON DELETE`` SQL clauses for a foreign key, or
+    ``""`` when both are ``"NO ACTION"``.
+    """
+    parts = []
+    if fk.on_update not in (None, "", "NO ACTION"):
+        parts.append("ON UPDATE {}".format(fk.on_update))
+    if fk.on_delete not in (None, "", "NO ACTION"):
+        parts.append("ON DELETE {}".format(fk.on_delete))
+    if not parts:
+        return ""
+    return " " + " ".join(parts)
+
