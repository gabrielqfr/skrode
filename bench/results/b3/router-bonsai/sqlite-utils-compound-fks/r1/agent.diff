+class ForeignKey:
+    """
+    A foreign key on a table.
+
+    ``column``
+        The name of the single foreign key column, or ``None`` if the key is compound
+    ``other_column``
+        The name of the referenced column, or ``None`` if the key is compound
+    ``columns``
+        The tuple of columns used by this key (compound or single)
+    ``other_columns``
+        The tuple of referenced columns used by this key (compound or single)
+    ``is_compound``
+        ``True`` when the key uses more than one column
+    ``on_delete``
+        The ``ON DELETE`` action, e.g. ``"CASCADE"`` or ``"NO ACTION"``
+    ``on_update``
+        The ``ON UPDATE`` action, e.g. ``"RESTRICT"`` or ``"NO ACTION"``
