+# -- raw provider payloads ---------------------------------------------
+#
+# A turn's response.json() payload is stored condensed: long strings and
+# subtrees that the turn's own messages, tools, schema or the model's
+# boilerplate already hold are replaced with {"$": key} references. The
+# replacement dictionary is never stored. It is rebuilt at read time
+# from the same rows by the same walk, so both sides agree.
+
+_CONDENSE_MIN_LENGTH = 64
+
+TURN_TOOLS_SQL = """
+select tools.name, tools.description
+  from turn_tools
+  join tools on tools.id = turn_tools.tool_id
+ where turn_tools.turn_id = ?
+"""
+
+
+def _payload_replacements(
+    messages, tools=(), schema=None, model_replacements=None
+) -> dict[str, Any]:
+    "The replacement dictionary for one turn, keyed by stable paths."
+    replacements: dict[str, Any] = {}
+
+    def offer(key: str, value: Any) -> None:
+        if isinstance(value, str):
+            if len(value) >= _CONDENSE_MIN_LENGTH:
+                replacements[key] = value
+        elif isinstance(value, (dict, list)) and value:
+            try:
+                size = len(json.dumps(value, separators=(",", ":")))
+            except (TypeError, ValueError):
+                return
+            if size >= _CONDENSE_MIN_LENGTH:
+                replacements[key] = value
+
+    def walk(obj: Any, prefix: str) -> None:
+        offer(prefix, obj)
+        if isinstance(obj, dict):
+            for key, value in obj.items():
+                walk(value, f"{prefix}.{key}")
+        elif isinstance(obj, list):
+            for index, item in enumerate(obj):
+                walk(item, f"{prefix}.{index}")
+
+    for mi, message in enumerate(messages):
+        message_dict = message.to_dict()
+        for pi, part in enumerate(message_dict.get("parts", [])):
+            base = f"{mi}.{pi}"
+            offer(f"{base}.text", part.get("text"))
+            offer(f"{base}.output", part.get("output"))
+            arguments = part.get("arguments")
+            if arguments:
+                compact = json.dumps(arguments, separators=(",", ":"))
+                offer(f"{base}.args", compact)
+                spaced = json.dumps(arguments)
+                if spaced != compact:
+                    offer(f"{base}.args2", spaced)
+                offer(f"{base}.argsv", arguments)
+            walk(part.get("provider_metadata") or {}, f"{base}.pm")
+        walk(message_dict.get("provider_metadata") or {}, f"{mi}.pm")
+
+    # A tool name with two different long descriptions cannot say which
+    # one a reference means, so it is dropped on both sides.
+    descriptions: dict[str, str] = {}
+    ambiguous: set[str] = set()
+    for name, description in tools:
+        if not name or not isinstance(description, str):
+            continue
+        if len(description) < _CONDENSE_MIN_LENGTH:
+            continue
+        if descriptions.setdefault(name, description) != description:
+            ambiguous.add(name)
+    for name, description in descriptions.items():
+        if name not in ambiguous:
+            replacements[f"tool.{name}.description"] = description
+
+    offer("schema", schema)
+    for key, value in (model_replacements or {}).items():
+        replacements[f"m.{key}"] = value
+    return replacements
+
+
+def condense_payload(
+    payload, messages, tools=(), schema=None, model_replacements=None
+) -> str | None:
+    "The payload as condensed JSON text, or None when there is no payload."
+    if payload is None:
+        return None
+    replacements = _payload_replacements(messages, tools, schema, model_replacements)
+    return json.dumps(condense_json(payload, replacements))
+
+
+def resolve_payload(
+    condensed, messages, tools=(), schema=None, model_replacements=None
+):
+    "Reverse condense_payload. Raises UncondenseError on an unresolved reference."
+    if condensed is None:
+        return None
+    replacements = _payload_replacements(messages, tools, schema, model_replacements)
+    return uncondense_json(json.loads(condensed), replacements)
+
+
+def _model_json_replacements(model_id) -> dict[str, Any] | None:
+    "The json_replacements dictionary of the model, if it still exists."
+    if not model_id:
+        return None
+    # Imported here: llm imports this module, so a top-level import cycles.
+    from llm import UnknownModelError, get_model
+
+    try:
+        model = get_model(model_id)
+    except UnknownModelError:
+        return None
+    return getattr(model, "json_replacements", None)
+
+
