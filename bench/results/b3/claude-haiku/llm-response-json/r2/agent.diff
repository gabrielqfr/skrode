+# -- condensed provider payloads ----------------------------------------
+#
+# A turn's raw response.json() is stored condensed: any string or subtree
+# that the turn's own messages, tools, schema or the model's boilerplate
+# already hold becomes a {"$": key} reference. The replacement dict is
+# never stored. It is rebuilt from the same rows at read time, so walking
+# the same inputs gives the same keys and values on both sides.
+
+# Shorter strings and subtrees are cheaper to keep inline than to reference.
+_CONDENSE_MIN_LENGTH = 64
+
+TURN_TOOLS_SQL = """
+select tools.name, tools.description
+  from turn_tools
+  join tools on tools.id = turn_tools.tool_id
+ where turn_tools.turn_id = ?
+"""
+
+
+def _condensable(value) -> bool:
+    if isinstance(value, str):
+        return len(value) >= _CONDENSE_MIN_LENGTH
+    if isinstance(value, (dict, list)) and value:
+        try:
+            encoded = json.dumps(value, separators=(",", ":"))
+        except (TypeError, ValueError):
+            return False
+        return len(encoded) >= _CONDENSE_MIN_LENGTH
+    return False
+
+
+def _payload_replacements(
+    messages, tools=(), schema=None, model_replacements=None
+) -> dict[str, Any]:
+    """Every value a payload may reference, keyed by where it lives.
+
+    Keys name a position in the turn's own messages (``0.1.text``), a
+    tool (``tool.<name>.description``), the schema, or the model's
+    boilerplate (``m.<key>``), so the dict can be rebuilt from the stored
+    rows when the payload is read back.
+    """
+    replacements: dict[str, Any] = {}
+
+    def offer(key: str, value) -> None:
+        if _condensable(value):
+            replacements[key] = value
+
+    def walk(obj, prefix: str) -> None:
+        offer(prefix, obj)
+        if isinstance(obj, dict):
+            for key, value in obj.items():
+                walk(value, f"{prefix}.{key}")
+        elif isinstance(obj, list):
+            for index, item in enumerate(obj):
+                walk(item, f"{prefix}.{index}")
+
+    for mi, message in enumerate(messages):
+        message_dict = message.to_dict()
+        for pi, part in enumerate(message_dict.get("parts", [])):
+            base = f"{mi}.{pi}"
+            offer(f"{base}.text", part.get("text"))
+            offer(f"{base}.output", part.get("output"))
+            arguments = part.get("arguments")
+            if arguments:
+                compact = json.dumps(arguments, separators=(",", ":"))
+                offer(f"{base}.args", compact)
+                pretty = json.dumps(arguments)
+                if pretty != compact:
+                    offer(f"{base}.args2", pretty)
+                offer(f"{base}.argsv", arguments)
+            walk(part.get("provider_metadata") or {}, f"{base}.pm")
+        walk(message_dict.get("provider_metadata") or {}, f"{mi}.pm")
+
+    # A name described two different ways cannot name either one
+    # unambiguously, so it is left out whatever order the pairs arrive in.
+    descriptions: dict[str, str] = {}
+    conflicted: set[str] = set()
+    for name, description in tools:
+        if not name or not isinstance(description, str):
+            continue
+        if len(description) < _CONDENSE_MIN_LENGTH:
+            continue
+        if descriptions.setdefault(name, description) != description:
+            conflicted.add(name)
+    for name, description in descriptions.items():
+        if name not in conflicted:
+            replacements[f"tool.{name}.description"] = description
+
+    offer("schema", schema)
+
+    for key, value in (model_replacements or {}).items():
+        replacements[f"m.{key}"] = value
+
+    return replacements
+
+
+def condense_payload(
+    payload, messages, tools=(), schema=None, model_replacements=None
+) -> str | None:
+    "The payload as condensed JSON text, or None when there is no payload."
+    if payload is None:
+        return None
+    replacements = _payload_replacements(messages, tools, schema, model_replacements)
+    return json.dumps(condense_json(payload, replacements))
+
+
+def resolve_payload(
+    condensed, messages, tools=(), schema=None, model_replacements=None
+):
+    """Reverse ``condense_payload``. Raises ``UncondenseError`` if a
+    reference no longer resolves against the rows it was made from."""
+    if condensed is None:
+        return None
+    replacements = _payload_replacements(messages, tools, schema, model_replacements)
+    return uncondense_json(json.loads(condensed), replacements)
+
+
+def _model_json_replacements(model_id: str | None) -> dict[str, Any] | None:
+    if not model_id:
+        return None
+    # Imported here: the llm package imports this module.
+    from llm import UnknownModelError, get_model
+
+    try:
+        model = get_model(model_id)
+    except UnknownModelError:
+        # Markers that needed the dictionary will fail to resolve later
+        # with UncondenseError, rather than here.
+        return None
+    return getattr(model, "json_replacements", None)
+
+
