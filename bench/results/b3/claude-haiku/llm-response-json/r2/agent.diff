+    def _reasoning_refresh_events(
+        self, response_json: dict[str, Any], done_events: dict[str, StreamEvent]
+    ) -> list[StreamEvent]:
+        """Restate the final encrypted_content of each streamed reasoning item.
+
+        OpenAI encrypts per event, so the ciphertext in response.completed
+        differs from the one yielded at response.output_item.done. Yielding
+        the final metadata again, on the same part, keeps the stored part
+        and response_json in agreement. Adds no text.
+        """
+        refreshed: list[StreamEvent] = []
+        for item in response_json.get("output") or []:
+            if not isinstance(item, dict) or item.get("type") != "reasoning":
+                continue
+            prior = done_events.get(item.get("id"))
+            if prior is None or prior.part_index is None:
+                continue
+            meta = {
+                key: item[key]
+                for key in ("id", "encrypted_content", "summary")
+                if item.get(key)
+            }
+            if meta:
+                refreshed.append(
+                    StreamEvent(
+                        type="reasoning",
+                        chunk="",
+                        part_index=prior.part_index,
+                        provider_metadata={"openai": meta},
+                    )
+                )
+        return refreshed
+
 
