+@dataclass(order=True)
+class ForeignKey:
+    """
+    A foreign key. Single-column keys set ``column`` and ``other_column``; compound
+    keys set ``columns`` and ``other_columns`` and leave ``column`` and
+    ``other_column`` as ``None``.
+    """
+
+    table: str
+    column: Optional[str] = field(compare=False)
+    other_table: str
+    other_column: Optional[str] = field(compare=False)
+    columns: Tuple[str, ...] = ()
+    other_columns: Tuple[str, ...] = ()
+    is_compound: bool = False
+    on_delete: str = "NO ACTION"
+    on_update: str = "NO ACTION"
+
+    def __post_init__(self):
+        if self.columns:
+            self.columns = tuple(self.columns)
+        else:
+            self.columns = () if self.column is None else (self.column,)
+        if self.other_columns:
+            self.other_columns = tuple(self.other_columns)
+        else:
+            self.other_columns = (
+                () if self.other_column is None else (self.other_column,)
+            )
+
+
+def _fk_actions_sql(fk: ForeignKey) -> str:
+    "SQL for the ``ON UPDATE`` and ``ON DELETE`` actions of a foreign key, if any."
+    sql = ""
+    if fk.on_update and fk.on_update != "NO ACTION":
+        sql += " ON UPDATE {}".format(fk.on_update)
+    if fk.on_delete and fk.on_delete != "NO ACTION":
+        sql += " ON DELETE {}".format(fk.on_delete)
+    return sql
+
+
+ForeignKeyColumns = Union[str, Tuple[str, ...], List[str]]
+ForeignKeyTuple = Tuple[str, ForeignKeyColumns, str, ForeignKeyColumns]
+
+
+def _fk_matches_drop(
+    fk: ForeignKey, drop_foreign_keys: List[ForeignKeyColumns]
+) -> bool:
+    "True if a column name in drop_foreign_keys belongs to fk, or a tuple/list equals its columns"
+    for item in drop_foreign_keys:
+        if isinstance(item, (list, tuple)):
+            if tuple(item) == fk.columns:
+                return True
+        elif item in fk.columns:
+            return True
+    return False
+
+
+def _rename_fk(fk: ForeignKey, rename: Dict[str, str]) -> ForeignKey:
+    "Return fk with its local columns renamed; other_columns never change"
+    columns = tuple(rename.get(c) or c for c in fk.columns)
+    return replace(
+        fk,
+        column=None if fk.is_compound else columns[0],
+        columns=columns,
+    )
+
