diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..8074400f
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,145 @@
+"""
+Supervised background tasks. Plugins register long-lived coroutine functions
+with ``datasette.add_background_task()``; the supervisor launches them once
+startup has finished, keeps a reference to each, logs crashes and can cancel
+them all.
+"""
+
+import asyncio
+import inspect
+import logging
+from datetime import datetime, timezone
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+class BackgroundTask:
+    """Handle for a single registered background task."""
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        if self.task is not None:
+            # State becomes "cancelled" later, in the done callback
+            self.task.cancel()
+        elif self._supervisor is not None:
+            # Never launched: drop it so it never runs
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    """Owns the background tasks for one Datasette instance."""
+
+    def __init__(self, datasette):
+        self.datasette = datasette
+        self._handles = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def add(self, func, name=None):
+        base = name or getattr(func, "__qualname__", None) or repr(func)
+        unique = base
+        suffix = 2
+        while unique in self._names:
+            unique = f"{base}-{suffix}"
+            suffix += 1
+        handle = BackgroundTask(unique, func, plugin=self._plugin_name_for(func))
+        handle._supervisor = self
+        self._handles.append(handle)
+        self._names.add(unique)
+        if self._launched:
+            self._launch(handle)
+        return handle
+
+    def _plugin_name_for(self, func):
+        try:
+            from datasette.plugins import pm
+
+            func_module = func.__module__
+            for plugin_name, plugin in pm.list_name_plugin():
+                if inspect.ismodule(plugin):
+                    plugin_module = plugin.__name__
+                else:
+                    plugin_module = type(plugin).__module__
+                if func_module == plugin_module or func_module.startswith(
+                    plugin_module + "."
+                ):
+                    return plugin_name
+        except Exception:
+            return None
+        return None
+
+    def _remove(self, handle):
+        if handle in self._handles:
+            self._handles.remove(handle)
+            self._names.discard(handle.name)
+
+    async def launch_all(self):
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in self._handles:
+                if handle.task is None:
+                    self._launch(handle)
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = datetime.now(timezone.utc).isoformat()
+        handle.task = asyncio.create_task(
+            handle._func(self.datasette), name=handle.name
+        )
+        handle.task.add_done_callback(lambda task: self._on_done(handle, task))
+
+    def _on_done(self, handle, task):
+        if task.cancelled():
+            handle.state = "cancelled"
+            return
+        exc = task.exception()
+        if exc is not None:
+            handle.exception = exc
+            handle.state = "crashed"
+            logger.error("Background task %r crashed", handle.name, exc_info=exc)
+        else:
+            handle.state = "completed"
+
+    async def cancel_all(self, grace=5.0):
+        pending = [
+            handle
+            for handle in self._handles
+            if handle.task is not None and not handle.task.done()
+        ]
+        if not pending:
+            return
+        for handle in pending:
+            handle.task.cancel()
+        _, still_running = await asyncio.wait(
+            [handle.task for handle in pending], timeout=grace
+        )
+        if still_running:
+            names = sorted(
+                handle.name for handle in pending if handle.task in still_running
+            )
+            logger.warning(
+                "%d background task(s) still running after %ss grace period: %s",
+                len(names),
+                grace,
+                ", ".join(names),
+            )
+
+    def tasks(self):
+        return list(self._handles)
