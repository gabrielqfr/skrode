diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..670d7c95
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,142 @@
+"""
+Supervised background tasks registered with ``datasette.add_background_task()``.
+
+Plugins register coroutine functions, usually from a ``startup`` hook. Core
+launches them once every ``startup`` hook has finished, keeps a reference to
+each task, logs crashes with their traceback and can cancel them all.
+"""
+
+import asyncio
+import datetime
+import logging
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+class BackgroundTask:
+    """Handle for a single background task."""
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        if self.task is not None:
+            # The state becomes "cancelled" later, in the done callback
+            self.task.cancel()
+        elif self._supervisor is not None:
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    """Owns every background task registered with a Datasette instance."""
+
+    def __init__(self, datasette):
+        self.datasette = datasette
+        self._handles = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def add(self, func, name=None):
+        base = name or getattr(func, "__qualname__", None) or repr(func)
+        unique = base
+        suffix = 2
+        while unique in self._names:
+            unique = f"{base}-{suffix}"
+            suffix += 1
+        handle = BackgroundTask(unique, func, plugin=self._plugin_name_for(func))
+        handle._supervisor = self
+        self._names.add(unique)
+        self._handles.append(handle)
+        if self._launched:
+            self._launch(handle)
+        return handle
+
+    def _plugin_name_for(self, func):
+        # Imported here: datasette.plugins imports datasette itself, which imports
+        # this module, so a top-level import would be circular
+        from datasette.plugins import pm
+
+        try:
+            module = func.__module__
+            for plugin_name, plugin in pm.list_name_plugin():
+                plugin_module = getattr(plugin, "__name__", None)
+                if plugin_module is None:
+                    continue
+                if module == plugin_module or module.startswith(plugin_module + "."):
+                    return plugin_name
+        except Exception:  # noqa: BLE001
+            return None
+        return None
+
+    def _remove(self, handle):
+        if handle in self._handles:
+            self._handles.remove(handle)
+        self._names.discard(handle.name)
+
+    async def launch_all(self):
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in self._handles:
+                if handle.task is None:
+                    self._launch(handle)
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = (
+            datetime.datetime.now(datetime.timezone.utc).isoformat()
+        )
+        handle.task = asyncio.create_task(
+            handle._func(self.datasette), name=handle.name
+        )
+
+        def _done(task):
+            if task.cancelled():
+                handle.state = "cancelled"
+                return
+            exc = task.exception()
+            if exc is not None:
+                handle.exception = exc
+                handle.state = "crashed"
+                logger.error(
+                    "Background task %r crashed", handle.name, exc_info=exc
+                )
+            else:
+                handle.state = "completed"
+
+        handle.task.add_done_callback(_done)
+
+    async def cancel_all(self, grace: float = 5.0):
+        pending = [
+            h.task for h in self._handles if h.task is not None and not h.task.done()
+        ]
+        if not pending:
+            return
+        for task in pending:
+            task.cancel()
+        _, still_running = await asyncio.wait(pending, timeout=grace)
+        if still_running:
+            names = sorted(t.get_name() for t in still_running)
+            logger.warning(
+                "%d background task(s) still running after %.1fs grace period: %s",
+                len(names),
+                grace,
+                ", ".join(names),
+            )
+
+    def tasks(self):
+        return list(self._handles)
