diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..c419966f
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,128 @@
+import asyncio
+import datetime
+import logging
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+class BackgroundTask:
+    "Handle for a supervised background task"
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        if self.task is not None:
+            self.task.cancel()
+        elif self._supervisor is not None:
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    def __init__(self, datasette):
+        self.datasette = datasette
+        self._handles = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def add(self, func, name=None):
+        base = name or getattr(func, "__qualname__", None) or repr(func)
+        unique = base
+        counter = 2
+        while unique in self._names:
+            unique = f"{base}-{counter}"
+            counter += 1
+        handle = BackgroundTask(unique, func, plugin=self._plugin_for(func))
+        handle._supervisor = self
+        self._handles.append(handle)
+        self._names.add(unique)
+        if self._launched:
+            self._launch(handle)
+        return handle
+
+    @staticmethod
+    def _plugin_for(func):
+        try:
+            from datasette.plugins import pm
+
+            module = getattr(func, "__module__", None)
+            if not module:
+                return None
+            for plugin_name, plugin in pm.list_name_plugin():
+                plugin_module = getattr(plugin, "__name__", None)
+                if plugin_module and (
+                    module == plugin_module or module.startswith(plugin_module + ".")
+                ):
+                    return plugin_name
+        except Exception:
+            return None
+        return None
+
+    def _remove(self, handle):
+        if handle in self._handles:
+            self._handles.remove(handle)
+            self._names.discard(handle.name)
+
+    async def launch_all(self):
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in list(self._handles):
+                if handle.task is None:
+                    self._launch(handle)
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
+        handle.task = asyncio.create_task(
+            handle._func(self.datasette), name=handle.name
+        )
+        handle.task.add_done_callback(lambda task: self._done(handle, task))
+
+    @staticmethod
+    def _done(handle, task):
+        if task.cancelled():
+            handle.state = "cancelled"
+            return
+        exc = task.exception()
+        if exc is not None:
+            handle.state = "crashed"
+            handle.exception = exc
+            logger.error("Background task %r crashed", handle.name, exc_info=exc)
+        else:
+            handle.state = "completed"
+
+    async def cancel_all(self, grace: float = 5.0):
+        pending = {
+            h.task for h in self._handles if h.task is not None and not h.task.done()
+        }
+        if not pending:
+            return
+        for task in pending:
+            task.cancel()
+        _, still = await asyncio.wait(pending, timeout=grace)
+        if still:
+            names = ", ".join(sorted(t.get_name() for t in still))
+            logger.warning(
+                "%d background task(s) still running after %s second grace period: %s",
+                len(still),
+                grace,
+                names,
+            )
+
+    def tasks(self):
+        return list(self._handles)
