+_CONDENSE_MIN_LENGTH = 64
+
+TURN_TOOLS_SQL = """
+select tools.name, tools.description
+from turn_tools
+join tools on tools.id = turn_tools.tool_id
+where turn_tools.turn_id = ?
+"""
+
+
+def _offer(out: dict, key: str, value: Any) -> None:
+    if isinstance(value, str):
+        if len(value) >= _CONDENSE_MIN_LENGTH:
+            out[key] = value
+    elif isinstance(value, (dict, list)) and value:
+        try:
+            size = len(json.dumps(value, separators=(",", ":")))
+        except (TypeError, ValueError):
+            return
+        if size >= _CONDENSE_MIN_LENGTH:
+            out[key] = value
+
+
+def _walk(out: dict, prefix: str, obj: Any) -> None:
+    if isinstance(obj, dict):
+        _offer(out, prefix, obj)
+        for key, value in obj.items():
+            _walk(out, f"{prefix}.{key}", value)
+    elif isinstance(obj, list):
+        _offer(out, prefix, obj)
+        for index, item in enumerate(obj):
+            _walk(out, f"{prefix}.{index}", item)
+    else:
+        _offer(out, prefix, obj)
+
+
+def _payload_replacements(
+    messages, tools=(), schema=None, model_replacements=None
+) -> dict[str, Any]:
+    out: dict[str, Any] = {}
+    for mi, message in enumerate(messages):
+        message_dict = message.to_dict()
+        for pi, part in enumerate(message_dict.get("parts", [])):
+            base = f"{mi}.{pi}"
+            _offer(out, f"{base}.text", part.get("text"))
+            _offer(out, f"{base}.output", part.get("output"))
+            arguments = part.get("arguments")
+            if arguments:
+                compact = json.dumps(arguments, separators=(",", ":"))
+                _offer(out, f"{base}.args", compact)
+                spaced = json.dumps(arguments)
+                if spaced != compact:
+                    _offer(out, f"{base}.args2", spaced)
+                _offer(out, f"{base}.argsv", arguments)
+            _walk(out, f"{base}.pm", part.get("provider_metadata") or {})
+        _walk(out, f"{mi}.pm", message_dict.get("provider_metadata") or {})
+    seen: dict[str, str] = {}
+    dropped = set()
+    for name, description in tools:
+        if not name or not isinstance(description, str):
+            continue
+        if len(description) < _CONDENSE_MIN_LENGTH:
+            continue
+        if name in seen and seen[name] != description:
+            dropped.add(name)
+        seen.setdefault(name, description)
+    for name, description in seen.items():
+        if name not in dropped:
+            out[f"tool.{name}.description"] = description
+    _offer(out, "schema", schema)
+    for key, value in (model_replacements or {}).items():
+        out[f"m.{key}"] = value
+    return out
+
+
+def condense_payload(
+    payload, messages, tools=(), schema=None, model_replacements=None
+) -> str | None:
+    if payload is None:
+        return None
+    return json.dumps(
+        condense_json(
+            payload,
+            _payload_replacements(messages, tools, schema, model_replacements),
+        )
+    )
+
+
+def resolve_payload(
+    condensed, messages, tools=(), schema=None, model_replacements=None
+):
+    if condensed is None:
+        return None
+    return uncondense_json(
+        json.loads(condensed),
+        _payload_replacements(messages, tools, schema, model_replacements),
+    )
+
+
+def _model_json_replacements(model_id):
+    if not model_id:
+        return None
+    from . import UnknownModelError, get_model
+
+    try:
+        model = get_model(model_id)
+    except UnknownModelError:
+        return None
+    return getattr(model, "json_replacements", None) or None
+
+
 def _dump(value: dict | None) -> str | None:
     return json.dumps(value) if value else None
 
