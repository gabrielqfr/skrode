 class _SharedResponses(_Shared):
+    def _reasoning_refresh_events(
+        self, response_json, done_events: dict[str, StreamEvent]
+    ) -> list[StreamEvent]:
+        # OpenAI encrypts per event, so the ciphertext in the final
+        # payload differs from the one seen at output_item.done. Re-emit
+        # the final metadata against the same part.
+        events = []
+        for item in response_json.get("output") or []:
+            if not isinstance(item, dict) or item.get("type") != "reasoning":
+                continue
+            prior = done_events.get(item.get("id"))
+            if prior is None or prior.part_index is None:
+                continue
+            meta = {
+                key: item[key]
+                for key in ("id", "encrypted_content", "summary")
+                if item.get(key)
+            }
+            if meta:
+                events.append(
+                    StreamEvent(
+                        type="reasoning",
+                        chunk="",
+                        part_index=prior.part_index,
+                        provider_metadata={"openai": meta},
+                    )
+                )
+        return events
+
