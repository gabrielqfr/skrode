+    def _reasoning_refresh_events(
+        self, response_json, done_events
+    ) -> list[StreamEvent]:
+        """Metadata events that bring streamed reasoning parts up to date.
+
+        OpenAI encrypts per event: the ciphertext in the final
+        ``response.completed`` payload differs from the one on
+        ``response.output_item.done``. Each refresh event targets the part
+        its done event opened, so the stored part ends up with the final
+        payload's values.
+        """
+        events: list[StreamEvent] = []
+        for item in response_json.get("output") or []:
+            if not isinstance(item, dict) or item.get("type") != "reasoning":
+                continue
+            prior = done_events.get(item.get("id"))
+            if prior is None or prior.part_index is None:
+                continue
+            meta = {
+                key: item[key]
+                for key in ("id", "encrypted_content", "summary")
+                if item.get(key)
+            }
+            if meta:
+                events.append(
+                    StreamEvent(
+                        type="reasoning",
+                        chunk="",
+                        part_index=prior.part_index,
+                        provider_metadata={"openai": meta},
+                    )
+                )
+        return events
+
 
