+# -- raw response payloads ---------------------------------------------
+#
+# response.json() is stored on the turn, condensed: any string or JSON
+# subtree that the turn's own messages, tools, schema or the model's
+# boilerplate dictionary already hold is replaced by a {"$": key}
+# reference. The replacement dict is never stored. It is rebuilt at read
+# time from the same rows, so the same walk yields the same dict on both
+# sides.
+
+_CONDENSE_MIN_LENGTH = 64
+
+TURN_TOOLS_SQL = """
+select tools.name, tools.description
+  from turn_tools
+  join tools on tools.id = turn_tools.tool_id
+ where turn_tools.turn_id = ?
+"""
+
+TURN_RESPONSE_JSON_SQL = """
+select turns.model,
+       turns.parent_message_hash,
+       turns.tip_message_hash,
+       turns.response_json,
+       schemas.content as schema_json
+  from turns
+  left join schemas on turns.schema_id = schemas.id
+ where turns.id = ?
+"""
+
+
+def _payload_replacements(
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+) -> dict[str, Any]:
+    """The replacement dict a payload is condensed against.
+
+    Keys are positional paths into ``messages`` (``"mi.pi.text"`` and so
+    on), so the same messages always give the same keys. Only values long
+    enough to be worth a reference are offered.
+    """
+    replacements: dict[str, Any] = {}
+
+    def offer(key: str, value: Any) -> None:
+        if isinstance(value, str):
+            if len(value) >= _CONDENSE_MIN_LENGTH:
+                replacements[key] = value
+        elif isinstance(value, (dict, list)):
+            if not value:
+                return
+            try:
+                size = len(json.dumps(value, separators=(",", ":")))
+            except (TypeError, ValueError):
+                return
+            if size >= _CONDENSE_MIN_LENGTH:
+                replacements[key] = value
+
+    def walk(prefix: str, obj: Any) -> None:
+        offer(prefix, obj)
+        if isinstance(obj, dict):
+            for key, value in obj.items():
+                walk(f"{prefix}.{key}", value)
+        elif isinstance(obj, list):
+            for index, item in enumerate(obj):
+                walk(f"{prefix}.{index}", item)
+
+    for mi, message in enumerate(messages):
+        message_dict = message.to_dict()
+        for pi, part in enumerate(message_dict.get("parts", [])):
+            base = f"{mi}.{pi}"
+            offer(f"{base}.text", part.get("text"))
+            offer(f"{base}.output", part.get("output"))
+            arguments = part.get("arguments")
+            if arguments:
+                try:
+                    compact = json.dumps(arguments, separators=(",", ":"))
+                    spaced = json.dumps(arguments)
+                except (TypeError, ValueError):
+                    compact = spaced = None
+                if compact is not None:
+                    offer(f"{base}.args", compact)
+                    if spaced != compact:
+                        offer(f"{base}.args2", spaced)
+                    offer(f"{base}.argsv", arguments)
+            walk(f"{base}.pm", part.get("provider_metadata") or {})
+        walk(f"{mi}.pm", message_dict.get("provider_metadata") or {})
+
+    # A tool name seen with two different long descriptions cannot be
+    # resolved from the tools table alone, so it is dropped on both sides.
+    descriptions: dict[str, str] = {}
+    conflicting: set[str] = set()
+    for name, description in tools:
+        if not name:
+            continue
+        if not isinstance(description, str) or len(description) < _CONDENSE_MIN_LENGTH:
+            continue
+        if name in descriptions and descriptions[name] != description:
+            conflicting.add(name)
+        descriptions.setdefault(name, description)
+    for name, description in descriptions.items():
+        if name not in conflicting:
+            replacements[f"tool.{name}.description"] = description
+
+    if schema is not None:
+        offer("schema", schema)
+    for key, value in (model_replacements or {}).items():
+        replacements[f"m.{key}"] = value
+    return replacements
+
+
+def condense_payload(
+    payload: Any,
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+) -> str | None:
+    "The payload as condensed JSON text, or None when there is no payload."
+    if payload is None:
+        return None
+    return json.dumps(
+        condense_json(
+            payload,
+            _payload_replacements(messages, tools, schema, model_replacements),
+        )
+    )
+
+
+def resolve_payload(
+    condensed: str | None,
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+) -> Any:
+    """Reverse ``condense_payload``. Raises UncondenseError when a reference
+    no longer resolves against the rows it was condensed from."""
+    if condensed is None:
+        return None
+    return uncondense_json(
+        json.loads(condensed),
+        _payload_replacements(messages, tools, schema, model_replacements),
+    )
+
+
+def _model_json_replacements(model_id: str | None) -> dict[str, Any] | None:
+    """The json_replacements dictionary of the model a turn was logged with.
+
+    None when the model is no longer registered; payloads that needed its
+    dictionary then fail to resolve rather than resolving to a guess.
+    """
+    if not model_id:
+        return None
+    # Imported here: llm imports this module, so a top-level import would
+    # be circular.
+    from llm import UnknownModelError, get_model
+
+    try:
+        model = get_model(model_id)
+    except UnknownModelError:
+        return None
+    return getattr(model, "json_replacements", None)
+
+
