+    def _reasoning_refresh_events(
+        self, response_json, done_events
+    ) -> list[StreamEvent]:
+        """Re-emit reasoning metadata from the final payload.
+
+        OpenAI encrypts reasoning per event, so the ``encrypted_content``
+        in ``response.completed`` can differ from the one seen at
+        ``response.output_item.done``. Yielding a second metadata-only
+        event for the same part makes the stored ReasoningPart agree with
+        the payload. The framework merges it onto the existing part.
+        """
+        events: list[StreamEvent] = []
+        for item in response_json.get("output") or []:
+            if not isinstance(item, dict) or item.get("type") != "reasoning":
+                continue
+            prior = done_events.get(item.get("id"))
+            if prior is None or prior.part_index is None:
+                continue
+            meta: dict[str, Any] = {
+                key: item[key]
+                for key in ("id", "encrypted_content", "summary")
+                if item.get(key)
+            }
+            if meta:
+                events.append(
+                    StreamEvent(
+                        type="reasoning",
+                        chunk="",
+                        part_index=prior.part_index,
+                        provider_metadata={"openai": meta},
+                    )
+                )
+        return events
+
