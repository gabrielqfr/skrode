+# -- condensed provider payloads ----------------------------------------
+#
+# turns.response_json holds the raw provider payload with every long
+# string or JSON subtree that the turn already stores (its messages, its
+# tools, its schema, the model's json_replacements) replaced by a
+# {"$": key} reference. The replacement dict is never stored: it is
+# rebuilt from the same rows on the way out, so the same walk yields the
+# same keys on both sides.
+
+_CONDENSE_MIN_LENGTH = 64
+
+TURN_TOOLS_SQL = """
+select tools.name, tools.description
+  from turn_tools
+  join tools on tools.id = turn_tools.tool_id
+ where turn_tools.turn_id = ?
+"""
+
+
+def _dumps_compact(value: Any) -> str | None:
+    try:
+        return json.dumps(value, separators=(",", ":"))
+    except (TypeError, ValueError):
+        return None
+
+
+def _offer(out: dict[str, Any], key: str, value: Any) -> None:
+    "Offer ``value`` as a replacement under ``key`` if it is worth condensing."
+    if isinstance(value, str):
+        if len(value) >= _CONDENSE_MIN_LENGTH:
+            out[key] = value
+    elif isinstance(value, (dict, list)):
+        if not value:
+            return
+        compact = _dumps_compact(value)
+        if compact is not None and len(compact) >= _CONDENSE_MIN_LENGTH:
+            out[key] = value
+
+
+def _offer_walk(out: dict[str, Any], obj: Any, prefix: str) -> None:
+    "Offer every container and leaf of ``obj`` under its path."
+    _offer(out, prefix, obj)
+    if isinstance(obj, dict):
+        for key, value in obj.items():
+            _offer_walk(out, value, f"{prefix}.{key}")
+    elif isinstance(obj, list):
+        for index, item in enumerate(obj):
+            _offer_walk(out, item, f"{prefix}.{index}")
+
+
+def _payload_replacements(
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+) -> dict[str, Any]:
+    """The replacement dict for one turn's payload, keyed by position.
+
+    ``messages`` are the turn's own messages (its output), ``tools`` are
+    (name, description) pairs, ``schema`` the turn's schema and
+    ``model_replacements`` the model's json_replacements dictionary.
+    """
+    out: dict[str, Any] = {}
+    for mi, message in enumerate(messages):
+        message_dict = message.to_dict()
+        for pi, part in enumerate(message_dict.get("parts", [])):
+            base = f"{mi}.{pi}"
+            _offer(out, f"{base}.text", part.get("text"))
+            _offer(out, f"{base}.output", part.get("output"))
+            arguments = part.get("arguments")
+            if arguments:
+                compact = _dumps_compact(arguments)
+                if compact is not None:
+                    _offer(out, f"{base}.args", compact)
+                    try:
+                        spaced = json.dumps(arguments)
+                    except (TypeError, ValueError):
+                        spaced = None
+                    if spaced is not None and spaced != compact:
+                        _offer(out, f"{base}.args2", spaced)
+                _offer(out, f"{base}.argsv", arguments)
+            _offer_walk(out, part.get("provider_metadata") or {}, f"{base}.pm")
+        _offer_walk(out, message_dict.get("provider_metadata") or {}, f"{mi}.pm")
+
+    # A name seen with two different descriptions is ambiguous, so it is
+    # dropped on both sides whatever order the pairs arrive in.
+    descriptions: dict[str, str | None] = {}
+    for name, description in tools:
+        if not name or not isinstance(description, str):
+            continue
+        if len(description) < _CONDENSE_MIN_LENGTH:
+            continue
+        if name not in descriptions:
+            descriptions[name] = description
+        elif descriptions[name] != description:
+            descriptions[name] = None
+    for name, description in descriptions.items():
+        if description is not None:
+            out[f"tool.{name}.description"] = description
+
+    if schema is not None:
+        _offer(out, "schema", schema)
+    for key, value in (model_replacements or {}).items():
+        out[f"m.{key}"] = value
+    return out
+
+
+def condense_payload(
+    payload: Any,
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+) -> str | None:
+    "The payload as condensed JSON text, or None when there is no payload."
+    if payload is None:
+        return None
+    replacements = _payload_replacements(messages, tools, schema, model_replacements)
+    return json.dumps(condense_json(payload, replacements))
+
+
+def resolve_payload(
+    condensed: str | None,
+    messages,
+    tools=(),
+    schema=None,
+    model_replacements=None,
+) -> Any:
+    """Invert :func:`condense_payload`. Raises ``UncondenseError`` when a
+    reference no longer resolves against the rows it was condensed from."""
+    if condensed is None:
+        return None
+    replacements = _payload_replacements(messages, tools, schema, model_replacements)
+    return uncondense_json(json.loads(condensed), replacements)
+
+
+def _model_json_replacements(model_id: str | None) -> dict[str, Any] | None:
+    "The json_replacements dictionary of the model that produced a turn."
+    if not model_id:
+        return None
+    # Imported here: the llm package imports this module.
+    from llm import UnknownModelError, get_model
+
+    try:
+        model = get_model(model_id)
+    except UnknownModelError:
+        # Markers that needed the dictionary fail later, as
+        # UncondenseError, rather than resolving against nothing.
+        return None
+    return getattr(model, "json_replacements", None)
+
+
