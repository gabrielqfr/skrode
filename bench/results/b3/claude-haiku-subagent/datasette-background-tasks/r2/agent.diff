diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..1728a787
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,162 @@
+"""
+Supervised background tasks.
+
+Plugins register long-lived work with ``datasette.add_background_task()``.
+Core launches every registered task only after all ``startup`` hooks have
+finished, keeps a reference to each task, logs crashes with their traceback
+and can cancel them all.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import datetime
+import functools
+import inspect
+import logging
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+class BackgroundTask:
+    """Handle for a background task registered with a BackgroundTaskSupervisor.
+
+    States: ``registered`` -> ``running`` -> ``completed``, ``crashed`` or
+    ``cancelled``.
+    """
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        if self.task is not None:
+            # State becomes "cancelled" later, in the done callback.
+            self.task.cancel()
+        elif self._supervisor is not None:
+            # Never launched: deregister so it never runs.
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    """Owns the background tasks registered with a single Datasette instance."""
+
+    def __init__(self, datasette):
+        self.datasette = datasette
+        self._handles = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def add(self, func, name=None):
+        base = name or getattr(func, "__qualname__", None) or repr(func)
+        candidate = base
+        suffix = 2
+        while candidate in self._names:
+            candidate = f"{base}-{suffix}"
+            suffix += 1
+
+        handle = BackgroundTask(
+            candidate, func, plugin=self._plugin_name_for(func)
+        )
+        handle._supervisor = self
+        self._handles.append(handle)
+        self._names.add(candidate)
+
+        if self._launched:
+            self._launch(handle)
+        return handle
+
+    def _plugin_name_for(self, func):
+        try:
+            from datasette.plugins import pm
+
+            module = getattr(func, "__module__", None)
+            if not module:
+                return None
+            best_name = None
+            best_len = -1
+            for plugin_name, plugin in pm.list_name_plugin():
+                if inspect.ismodule(plugin):
+                    plugin_module = plugin.__name__
+                elif inspect.isclass(plugin):
+                    plugin_module = plugin.__module__
+                else:
+                    plugin_module = type(plugin).__module__
+                if not plugin_module:
+                    continue
+                if module == plugin_module or module.startswith(plugin_module + "."):
+                    if len(plugin_module) > best_len:
+                        best_name = plugin_name
+                        best_len = len(plugin_module)
+            return best_name
+        except Exception:  # noqa: BLE001
+            return None
+
+    def _remove(self, handle):
+        if handle in self._handles:
+            self._handles.remove(handle)
+        self._names.discard(handle.name)
+        handle._supervisor = None
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
+        handle.task = asyncio.create_task(
+            handle._func(self.datasette), name=handle.name
+        )
+        handle.task.add_done_callback(functools.partial(self._on_done, handle))
+
+    def _on_done(self, handle, task):
+        if task.cancelled():
+            handle.state = "cancelled"
+            return
+        exc = task.exception()
+        if exc is not None:
+            handle.state = "crashed"
+            handle.exception = exc
+            logger.error("Background task %r crashed", handle.name, exc_info=exc)
+        else:
+            handle.state = "completed"
+
+    async def launch_all(self):
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in list(self._handles):
+                if handle.task is None:
+                    self._launch(handle)
+
+    async def cancel_all(self, grace: float = 5.0):
+        handles = [
+            h for h in self._handles if h.task is not None and not h.task.done()
+        ]
+        if not handles:
+            return
+        for handle in handles:
+            handle.task.cancel()
+        pending = {h.task for h in handles}
+        await asyncio.wait(pending, timeout=grace)
+        stragglers = sorted(h.name for h in handles if not h.task.done())
+        if stragglers:
+            logger.warning(
+                "%d background task(s) still running %s seconds after cancel_all: %s",
+                len(stragglers),
+                grace,
+                ", ".join(stragglers),
+            )
+
+    def tasks(self):
+        return list(self._handles)
