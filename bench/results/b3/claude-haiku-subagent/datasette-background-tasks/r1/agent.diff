diff --git a/datasette/background_tasks.py b/datasette/background_tasks.py
new file mode 100644
index 00000000..a63971d9
--- /dev/null
+++ b/datasette/background_tasks.py
@@ -0,0 +1,148 @@
+"""Supervised background tasks for plugins.
+
+Plugins register long-lived work with ``datasette.add_background_task()``.
+The supervisor keeps a reference to every launched task, logs crashes with
+their traceback, and can cancel them all. Tasks are launched only after every
+``startup`` hook has finished.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import datetime
+import inspect
+import logging
+
+logger = logging.getLogger("datasette.background_tasks")
+
+
+class BackgroundTask:
+    """Handle for a background task registered with a supervisor."""
+
+    def __init__(self, name, func, plugin=None):
+        self.name = name
+        self.state = "registered"
+        self.task = None
+        self.exception = None
+        self.started_at = None
+        self.plugin = plugin
+        self._func = func
+        self._supervisor = None
+
+    def cancel(self):
+        if self.task is not None:
+            # The state becomes "cancelled" later, in the done callback
+            self.task.cancel()
+        elif self._supervisor is not None:
+            # Not launched yet: deregister so it never runs
+            self._supervisor._remove(self)
+
+    def __repr__(self):
+        return f"<BackgroundTask name={self.name!r} state={self.state!r}>"
+
+
+class BackgroundTaskSupervisor:
+    """Owns the background tasks registered against a single Datasette."""
+
+    def __init__(self, datasette):
+        self.datasette = datasette
+        self._handles = []
+        self._names = set()
+        self._launched = False
+        self._lock = asyncio.Lock()
+
+    def add(self, func, name=None) -> BackgroundTask:
+        base = name or getattr(func, "__qualname__", None) or repr(func)
+        candidate = base
+        suffix = 2
+        while candidate in self._names:
+            candidate = f"{base}-{suffix}"
+            suffix += 1
+        self._names.add(candidate)
+
+        handle = BackgroundTask(candidate, func, plugin=self._plugin_name_for(func))
+        handle._supervisor = self
+        self._handles.append(handle)
+        if self._launched:
+            self._launch(handle)
+        return handle
+
+    def _plugin_name_for(self, func):
+        try:
+            func_module = func.__module__
+            if not func_module:
+                return None
+            from datasette.plugins import pm
+
+            for plugin_name, plugin in pm.list_name_plugin():
+                if inspect.ismodule(plugin):
+                    plugin_module = plugin.__name__
+                else:
+                    plugin_module = type(plugin).__module__
+                if plugin_module and (
+                    func_module == plugin_module
+                    or func_module.startswith(plugin_module + ".")
+                ):
+                    return plugin_name
+            return None
+        except Exception:
+            return None
+
+    async def launch_all(self):
+        if self._launched:
+            return
+        async with self._lock:
+            if self._launched:
+                return
+            self._launched = True
+            for handle in self._handles:
+                if handle.task is None:
+                    self._launch(handle)
+
+    def _launch(self, handle):
+        handle.state = "running"
+        handle.started_at = (
+            datetime.datetime.now(datetime.timezone.utc).isoformat()
+        )
+        handle.task = asyncio.create_task(
+            handle._func(self.datasette), name=handle.name
+        )
+        handle.task.add_done_callback(lambda task: self._on_done(handle, task))
+
+    def _on_done(self, handle, task):
+        if task.cancelled():
+            handle.state = "cancelled"
+            return
+        exc = task.exception()
+        if exc is not None:
+            handle.state = "crashed"
+            handle.exception = exc
+            logger.error("Background task %r crashed", handle.name, exc_info=exc)
+        else:
+            handle.state = "completed"
+
+    def _remove(self, handle):
+        if handle in self._handles:
+            self._handles.remove(handle)
+            self._names.discard(handle.name)
+
+    async def cancel_all(self, grace: float = 5.0):
+        pending = [
+            h.task for h in self._handles if h.task is not None and not h.task.done()
+        ]
+        if not pending:
+            return
+        for task in pending:
+            task.cancel()
+        await asyncio.wait(pending, timeout=grace)
+        stragglers = sorted(t.get_name() for t in pending if not t.done())
+        if stragglers:
+            logger.warning(
+                "%d background task(s) still running after %ss grace period: %s",
+                len(stragglers),
+                grace,
+                ", ".join(stragglers),
+            )
+
+    def tasks(self) -> list[BackgroundTask]:
+        return list(self._handles)
