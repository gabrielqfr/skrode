{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "local": {
          "name": "Local model (plan or build profile)",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "llama.cpp/local",
  "small_model": "llama.cpp/local",
  "share": "disabled",
  "autoupdate": false,
  "agent": {
    "build": {
      "steps": 150,
      "permission": {
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "uv run pytest*": "allow",
          "uv run ruff check*": "allow",
          "scripts/verify.sh*": "allow",
          "bash scripts/verify.sh*": "allow",
          "tail*": "allow",
          "head*": "allow"
        },
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*uv.lock": "deny",
          "*profiles/*.yaml": "deny",
          "*profiles/*.yml": "deny"
        },
        "external_directory": "deny",
        "task": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "plan": {
      "disable": true
    }
  }
}
